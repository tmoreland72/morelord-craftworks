<section class="ml-app ml-app-shell ml-craftworks app-shell">
  <header class="ml-hero"><i class="fa-solid fa-hammer ml-hero__icon"></i><div class="ml-hero__body"><h1>Delerium Search</h1><p>A deliberate search takes 1 hour per ¼-mile hex.</p></div><div class="ml-actions"><button type="button" data-action="open-module-documentation"><i class="fa-solid fa-book-open"></i> Documentation</button></div></header>
  {{#if session}}
    <div class="ml-surface ml-section ml-craftworks-panel ml-stack" data-gap="3"><div class="ml-section-heading"><div><h2>{{session.zone.name}}</h2><p>{{session.sceneName}} • DC {{session.zone.dc}} • 1 hour • ¼ mile</p></div></div></div>
    <div class="ml-surface ml-section ml-craftworks-panel ml-stack" data-gap="3">
      <div class="ml-section-heading"><div><h2>Player Progress</h2><p>Review each character’s participation and resolved checks.</p></div></div>
      {{#each progress}}
        <div class="ml-card ml-craftworks-progress-card">
          <div class="ml-craftworks-progress-summary">
            <div><strong>{{actorName}}</strong><small>{{#if active}}Connected: {{user}}{{else}}No connected player{{/if}}</small></div>
            <span class="ml-craftworks-progress-status">{{status}}{{#if total}} · {{total}}{{/if}}{{#if successes}} · +{{successes}} {{#if (eq successes 1)}}success{{else}}successes{{/if}}{{/if}}</span>
          </div>
          {{#if gmCanRoll}}
            <div class="ml-craftworks-progress-rolls">
              <small>Roll for this character</small>
              <div class="ml-craftworks-player-skill-grid">
              {{#each skills}}
                <button type="button" data-action="gm-roll" data-participant-id="{{../participantId}}" data-actor-uuid="{{../actorUuid}}" data-skill="{{id}}"><i class="fa-solid fa-dice-d20"></i><span>{{label}}</span><strong>{{modifierLabel}}</strong></button>
              {{/each}}
              </div>
            </div>
          {{/if}}
        </div>
      {{/each}}
    </div>
    <div class="ml-surface ml-section ml-craftworks-panel ml-stack" data-gap="3">
      <div class="ml-section-heading"><div><h2>What the Party Finds</h2><p>Rewards accumulate as the party earns more successes.</p></div></div>
      <div class="ml-craftworks-delerium-rewards">
        <div><strong>0–2 successes</strong><span>No delerium is found.</span></div>
        <div><strong>3 successes</strong><span>Roll <button type="button" data-party-finds-roll="3d6"><i class="fa-solid fa-dice"></i> 3d6</button> to determine how many Delerium Chips are found.</span></div>
        <div><strong>4 successes</strong><span>Roll <button type="button" data-party-finds-roll="1d6"><i class="fa-solid fa-dice"></i> 1d6</button> to determine how many Delerium Fragments are found, plus 3d6 Delerium Chips.</span></div>
        <div><strong>5 or more successes</strong><span>The party finds 1 Delerium Shard, plus 1d6 Delerium Fragments and 3d6 Delerium Chips.</span></div>
      </div>
    </div>
    <footer class="ml-page-footer ml-actions"><button type="button" data-action="finalize"><i class="fa-solid fa-flag-checkered"></i> Finalize Search</button></footer>
  {{else}}
    <div class="ml-surface ml-section ml-craftworks-panel ml-stack" data-gap="3"><div class="ml-section-heading"><div><h2>{{sceneName}}</h2><p>Configure this opportunity for the current scene.</p></div></div><label>Search Area<select name="zone">{{#each zones}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} — DC {{dc}}</option>{{/each}}</select></label><p class="notes">Each selected character rolls Arcana, Investigation, or Survival. Meeting the DC earns 1 success; beating it by 5+ or rolling a natural 20 earns 2.</p><section class="ml-surface ml-section ml-stack" data-gap="3">
        <div class="ml-section-heading"><div><h2>Player Characters</h2><p>Choose which characters participate in this search.</p></div></div>
        <div class="ml-actor-choice-grid">
          {{#each characters}}
            <label class="ml-actor-choice">
              <input type="checkbox" name="characterUuid" value="{{uuid}}" {{#if checked}}checked{{/if}}>
              <img src="{{img}}" alt="{{name}}">
              <span class="ml-stack" data-gap="1">
                <strong>{{name}}</strong>
                <small>{{#if connected}}{{userName}}{{else}}Offline · Not connected{{/if}}</small>
              </span>
            </label>
          {{else}}
            <p class="ml-text ml-craftworks-warning" data-tone="warning">No player character Actors are defined.</p>
          {{/each}}
        </div>
      </section><footer class="ml-page-footer ml-actions"><button type="button" data-action="save-defaults" title="Save this area and selected characters for future searches"><i class="fa-solid fa-floppy-disk"></i> Save as Default</button><button type="button" data-action="start"><i class="fa-solid fa-gem"></i> Start Delerium Search</button></footer></div>
  {{/if}}
</section>
