<section class="ml-app ml-app-shell ml-craftworks app-shell">
  <header class="ml-craftworks-header">
    <h2>Gathering Opportunity</h2>
    <p>{{session.terrain.name}} • DC {{session.terrain.dc}} • {{session.sceneName}}</p>
  </header>

  {{#if actor}}
    <div class="ml-craftworks-actor ml-craftworks-player-actor"><img src="{{actor.img}}" alt="{{actor.name}}"><strong>{{actor.name}}</strong></div>
  {{else}}
    <p class="ml-text ml-craftworks-warning" data-tone="warning">Select a token you own or configure a user character.</p>
  {{/if}}

  {{#if state}}
    <div class="ml-craftworks-panel">
      {{#if (eq state.status "declined")}}
        <p>You declined this gathering opportunity.</p>
      {{/if}}
      {{#if (eq state.status "failed")}}
        <p><strong>Nothing found.</strong> Your check total was {{state.total}}.</p>
      {{/if}}
      {{#if (eq state.status "succeeded")}}
        <p><strong>Gathering succeeded.</strong> Your check total was {{state.total}}.</p>
        <div class="ml-craftworks-result" data-document-uuid="{{state.result.itemUuid}}"><img src="{{state.result.img}}" alt="{{state.result.name}}"> {{state.result.name}} ×{{state.result.quantity}}</div>
        {{#if state.result.recipientName}}<p>Sent to <strong>{{state.result.recipientName}}</strong>.</p>{{/if}}
      {{/if}}
    </div>
  {{else}}
      <div class="ml-craftworks-panel">
        <p>Gathering is optional. Choose a skill or decline.</p>
        <div class="ml-craftworks-player-skill-grid">
          {{#each skills}}
            <button type="button" data-action="roll" data-skill="{{id}}"><i class="fa-solid fa-dice-d20"></i><span>{{label}}</span><strong>{{modifierLabel}}</strong></button>
          {{/each}}
        </div>
        <button class="ml-craftworks-player-decline" type="button" data-action="decline"><i class="fa-solid fa-ban"></i> Decline</button>
      </div>
  {{/if}}

  <footer class="ml-actions ml-craftworks-actions">
    <button type="button" data-action="close"><i class="fa-solid fa-xmark"></i> Close</button>
  </footer>
</section>
