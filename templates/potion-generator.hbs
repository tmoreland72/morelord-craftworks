<section class="ml-app ml-app-shell ml-craftworks app-shell ml-craftworks-potion-generator">
  <header class="ml-hero"><i class="fa-solid fa-hammer ml-hero__icon"></i><div class="ml-hero__body"><h1>Potion Generator</h1><p>Choose how many potions of each rarity to generate from enabled Item compendiums. Each draw is random and duplicates are allowed.</p></div>
  <div class="ml-actions"><button type="button" data-action="open-module-documentation"><i class="fa-solid fa-book-open"></i> Documentation</button></div></header>

  {{#if hasAccess}}
    {{#unless hasResult}}
    <section class="ml-surface ml-section ml-craftworks-panel ml-stack" data-gap="3">
      <div class="ml-section-heading"><div><h2>Generation Options</h2><p>Choose the available options and quantities to generate.</p></div></div>
      <fieldset class="ml-craftworks-generator-constraints">
        <legend>Potion Categories <small>(inferred from potion names; all selected by default)</small></legend>
        <div class="ml-craftworks-generator-option-grid">
          {{#each categories}}
            <label><input type="checkbox" data-potion-category="{{id}}" {{#if selected}}checked{{/if}}> {{label}}</label>
          {{/each}}
        </div>
      </fieldset>
      <div class="ml-craftworks-potion-rarity-grid">
        {{#each rarities}}
          <label class="ml-craftworks-potion-rarity-row">
            <span>
              <strong>{{label}}</strong>
              <small>{{available}} available</small>
            </span>
            <span class="ml-craftworks-generator-stepper" data-count-stepper>
              <input type="number" min="0" step="1" value="{{count}}" data-potion-rarity="{{id}}">
              <span class="ml-craftworks-generator-stepper-controls">
                <button type="button" data-count-adjust="1" aria-label="Add one {{label}} potion"><i class="fa-solid fa-chevron-up"></i></button>
                <button type="button" data-count-adjust="-1" aria-label="Remove one {{label}} potion"><i class="fa-solid fa-chevron-down"></i></button>
              </span>
            </span>
          </label>
        {{/each}}
      </div>

      <footer class="ml-page-footer ml-actions">
        <button type="button" data-action="generate-potions"><i class="fa-solid fa-dice"></i> Generate</button>
      </footer>
    </section>
    {{/unless}}

    {{#if hasResult}}
      <section class="ml-surface ml-section ml-craftworks-panel ml-craftworks-potion-preview ml-stack" data-gap="3">
        <div class="ml-section-heading"><div><h2><i class="fa-solid fa-flask"></i> {{resultCount}} Generated Potions</h2><p>Review and customize the generated items.</p></div></div>
        <div class="ml-actions"><button type="button" data-action="add-result"><i class="fa-solid fa-plus"></i> Add Potion</button></div>
        <div class="ml-craftworks-potion-results-scroll">
          {{#each resultGroups}}
            <div class="ml-craftworks-potion-result-group">
              <strong>{{label}}</strong>
              <div class="ml-craftworks-potion-result-list">
                {{#each potions}}
                  <div class="ml-craftworks-potion-result" data-document-uuid="{{uuid}}">
                    <img src="{{img}}" alt="{{name}}">
                    <span><strong>{{name}}</strong><small>{{sourceLabel}}</small></span>
                    <label><span>Quantity</span><input type="number" min="1" step="1" value="{{quantity}}" data-result-quantity="{{resultIndex}}" aria-label="Quantity of {{name}}"></label>
                    <button type="button" data-remove-result="{{resultIndex}}" aria-label="Remove {{name}}" title="Remove {{name}}"><i class="fa-solid fa-trash"></i></button>
                    <button type="button" data-potion-uuid="{{uuid}}" title="Open {{name}}"><i class="fa-solid fa-up-right-from-square"></i></button>
                  </div>
                {{/each}}
              </div>
            </div>
          {{/each}}
        </div>
      </section>

      <section class="ml-surface ml-section ml-craftworks-panel ml-stack" data-gap="3">
        <div class="ml-section-heading"><div><h2>Recipient</h2><p>Choose the character or party inventory that receives these items.</p></div></div>
        <label>Recipient
          <select name="recipient">
            <option value="">Choose character or group…</option>
            {{#each actors}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
          </select>
        </label>
        {{#if partyInfo.valid}}<p class="ml-craftworks-muted">The configured default is {{partyInfo.actorName}}.</p>{{/if}}
        <footer class="ml-page-footer ml-actions">
          <button type="button" data-action="reroll-potions"><i class="fa-solid fa-arrows-rotate"></i> Reroll</button>
          <button type="button" data-action="share-potions"><i class="fa-solid fa-message"></i> Display Results in Chat</button>
          <button type="button" data-action="award-potions"><i class="fa-solid fa-flask"></i> Award Generated Potions</button>
        </footer>
      </section>
    {{/if}}
  {{else}}
    <div class="ml-empty-state"><p class="ml-text ml-craftworks-warning" data-tone="premium">Potion Generator requires premium Craftworks access.</p></div>
  {{/if}}
</section>
