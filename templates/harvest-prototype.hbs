<div class="ml-app ml-app-shell ml-craftworks-harvest-shell">
  <header class="ml-hero"><i class="fa-solid fa-scalpel ml-hero__icon"></i><div class="ml-hero__body"><h1>Harvesting</h1><p>Select defeated creatures and characters to gather harvestable components.</p></div><div class="ml-actions"><button type="button" data-action="open-module-documentation"><i class="fa-solid fa-book-open"></i> Documentation</button></div></header><div class="ml-stack">
    {{#if session}}
      <div class="ml-craftworks-harvest-instructions">Players make one harvest attempt per creature and choose one component after a successful check.</div>
      <div class="ml-craftworks-harvest-summary"><span><i class="fa-solid fa-skull"></i> {{session.creatures.length}} Creatures</span><span><i class="fa-solid fa-users"></i> Player Progress</span></div>
    {{/if}}
  </div>

  <main class="ml-craftworks-harvest-creatures ml-stack" data-gap="3">
    {{#if session}}
      <section class="ml-surface ml-section ml-stack" data-gap="3">
        <div class="ml-section-heading"><div><h2>Player Windows</h2><p>Reopening a player's window restores this active session and keeps
          every roll and claimed component intact.</p></div></div>
        <div class="ml-craftworks-harvest-player-progress-list">
          {{#each progress}}
            <div class="ml-craftworks-harvest-player-progress-row">
              <strong>{{user}}</strong>
              {{#if completed}}
                <span class="ml-craftworks-harvest-harvesting-completed">
                  <i class="fa-solid fa-circle-check"></i>
                  Harvesting Completed
                </span>
              {{else}}
                <button
                  type="button"
                  data-action="reopen-harvest"
                  data-user-id="{{userId}}"
                  data-actor-uuid="{{actorUuid}}"
                >
                  <i class="fa-solid fa-window-restore"></i>
                  {{#if gmRoll}}Roll as GM{{else}}Reopen Window{{/if}}
                </button>
              {{/if}}
            </div>
          {{/each}}
        </div>
      </section>

      {{#each session.creatures}}
        <section class="ml-card ml-craftworks-harvest-creature {{#if isCollapsed}}ml-craftworks-harvest-creature-collapsed{{/if}}" data-creature-token="{{tokenUuid}}">
          <header class="ml-craftworks-harvest-creature-header">
            {{#if img}}
              <img class="ml-craftworks-harvest-creature-image" src="{{img}}" alt="{{name}}">
            {{/if}}

            <div class="ml-craftworks-harvest-creature-info">
              <h2>{{name}}</h2>
              <div class="ml-craftworks-harvest-creature-meta">
                <span>{{creatureType}} · CR {{cr}}</span>
                <span>Harvest DC {{dc}}</span>
                {{#if harvestRarity}}
                  <span class="ml-craftworks-harvest-rarity">{{harvestRarity}}</span>
                {{/if}}
                {{#if (eq harvestMode "drakkenheim")}}
                  <span class="ml-craftworks-harvest-has-claim">
                    <i class="fa-solid fa-radiation"></i>
                    Drakkenheim Components
                  </span>
                {{else}}
                  <span>
                    <i class="fa-solid fa-leaf"></i>
                    Standard Harvest
                  </span>
                {{/if}}
              </div>
            </div>

            <button
              type="button"
              class="ml-craftworks-harvest-creature-toggle"
              data-action="toggle-creature"
              data-creature="{{tokenUuid}}"
              title="{{#if isCollapsed}}Expand{{else}}Collapse{{/if}}"
            >
              <i class="fa-solid {{#if isCollapsed}}fa-chevron-down{{else}}fa-chevron-up{{/if}}"></i>
            </button>
          </header>

          {{#unless isCollapsed}}
            {{#if (eq harvestMode "drakkenheim")}}
              <div class="ml-craftworks-harvest-components ml-craftworks-harvest-preview-components">
                {{#each components}}
                  <article class="ml-craftworks-harvest-component {{#unless matched}}ml-craftworks-harvest-component-unavailable{{/unless}}">
                    <div class="ml-craftworks-harvest-component-image">
                      {{#if img}}
                        <img src="{{img}}" alt="{{name}}">
                      {{else}}
                        <i class="fa-solid fa-flask"></i>
                      {{/if}}
                    </div>

                    <div class="ml-craftworks-harvest-component-body">
                      <div class="ml-craftworks-harvest-component-name">{{componentName}}{{#if quantity}} ×{{quantity}}{{/if}}</div>
                      <div class="ml-craftworks-harvest-component-category">{{category}} · {{rarity}}{{#if harvestDc}} · DC {{harvestDc}}{{/if}}</div>
                      {{#if name}}
                        <div class="ml-craftworks-harvest-ingredient-name">
                          <i class="fa-solid fa-arrow-right"></i>
                          {{name}}
                        </div>
                      {{/if}}
                    </div>

                    <div class="ml-craftworks-harvest-component-action">
                      {{#if claimed}}
                        <div class="ml-craftworks-harvest-claim-status ml-craftworks-harvest-taken">
                          <i class="fa-solid fa-lock"></i>
                          <span>
                            Claimed by <strong>{{claimantName}}</strong>{{#if multipleClaims}} (multiple claims){{/if}}
                            {{#if claimRoll}} · Roll {{claimRoll}}{{/if}}
                          </span>
                        </div>
                      {{else}}
                        <div class="ml-craftworks-harvest-claim-status {{#if matched}}ml-craftworks-harvest-mine{{else}}ml-craftworks-harvest-unavailable{{/if}}">
                          {{#if matched}}Available{{else}}No material match{{/if}}
                        </div>
                      {{/if}}
                    </div>
                  </article>
                {{/each}}
              </div>
            {{else}}
              <div class="ml-craftworks-harvest-components ml-craftworks-harvest-preview-components">
                {{#each components}}
                  <article class="ml-craftworks-harvest-component" data-document-uuid="{{itemUuid}}">
                    <div class="ml-craftworks-harvest-component-image">
                      {{#if img}}
                        <img src="{{img}}" alt="{{name}}">
                      {{else}}
                        <i class="fa-solid fa-flask"></i>
                      {{/if}}
                    </div>

                    <div class="ml-craftworks-harvest-component-body">
                      <div class="ml-craftworks-harvest-component-name">{{componentName}}{{#if quantity}} ×{{quantity}}{{/if}}</div>
                      <div class="ml-craftworks-harvest-component-category">
                        {{category}}{{#if rarity}} · {{rarity}}{{/if}}{{#if harvestDc}} · DC {{harvestDc}}{{/if}}{{#if sourceRoll}} · d100 {{sourceRoll}}{{/if}}
                      </div>
                      {{#if name}}
                        <div class="ml-craftworks-harvest-ingredient-name">
                          <i class="fa-solid fa-arrow-right"></i>{{name}}
                        </div>
                      {{/if}}
                    </div>

                    <div class="ml-craftworks-harvest-component-action">
                      {{#if claimed}}
                        <div class="ml-craftworks-harvest-claim-status ml-craftworks-harvest-taken">
                          <i class="fa-solid fa-lock"></i>
                          <span>
                            Claimed by <strong>{{claimantName}}</strong>{{#if multipleClaims}} (multiple claims){{/if}}
                            {{#if claimRoll}} · Roll {{claimRoll}}{{/if}}
                          </span>
                        </div>
                      {{else}}
                        <div class="ml-craftworks-harvest-claim-status ml-craftworks-harvest-mine">Available</div>
                      {{/if}}
                    </div>
                  </article>
                {{/each}}

                {{#unless components.length}}
          <div class="ml-text ml-craftworks-harvest-harvest-message ml-craftworks-warning" data-tone="warning">
                    No compatible Craftworks components are available for this creature.
                  </div>
                {{/unless}}
              </div>
            {{/if}}
          {{/unless}}
        </section>
      {{/each}}

      <section class="ml-surface ml-section ml-stack" data-gap="3">
        <div class="ml-section-heading"><div><h2>Claimed Components</h2><p>Review the {{claimedItems.length}} components claimed during this harvest.</p></div></div>

        {{#if claimedItems.length}}
          <div class="ml-craftworks-harvest-claimed-list">
            {{#each claimedItems}}
              <article class="ml-card ml-craftworks-harvest-claimed-item" data-document-uuid="{{linkUuid}}">
                <button
                  type="button"
                  class="ml-craftworks-harvest-claimed-image-link"
                  data-action="open-claimed-item"
                  data-uuid="{{linkUuid}}"
                  {{#unless linkUuid}}disabled{{/unless}}
                  title="{{#if linkUuid}}Open {{displayName}}{{else}}{{displayName}}{{/if}}"
                >
                  {{#if displayImg}}
                    <img src="{{displayImg}}" alt="{{displayName}}">
                  {{else}}
                    <i class="fa-solid fa-flask"></i>
                  {{/if}}
                </button>

                <div class="ml-craftworks-harvest-claimed-body">
                  <div class="ml-craftworks-harvest-claimed-name">{{displayName}}{{#if quantity}} ×{{quantity}}{{/if}}</div>
                  <div class="ml-craftworks-harvest-claimed-meta">
                    <span class="ml-craftworks-harvest-claimed-rarity">{{displayRarity}}</span>
                    <span>{{creatureName}}</span>
                    <span>Claimed by {{displayClaimant}}</span>
                  </div>
                </div>

                <div class="ml-craftworks-harvest-claimed-roll">
                  <span>Harvest Roll</span>
                  <strong>{{displayRoll}}</strong>
                </div>
              </article>
            {{/each}}
          </div>
        {{else}}
          <div class="ml-craftworks-harvest-claimed-empty">
            No components have been claimed yet.
          </div>
        {{/if}}
      </section>
    {{else}}
      {{#if deadCreatures.length}}
        <section class="ml-surface ml-section ml-stack" data-gap="3">
          <div class="ml-section-heading"><div><h2>{{deadCreatures.length}} defeated NPC token(s) found</h2><p>Defeated creatures available for this Harvest.</p></div></div>
          <p>Foundry cannot reliably distinguish a monster from a shopkeeper, trap, or other NPC-based token. Select only creatures that can be harvested.</p>

          <div class="ml-craftworks-harvest-preflight-selection-actions">
            <button type="button" data-action="select-all-harvest-creatures">
              <i class="fa-solid fa-check-double"></i>
              Select All
            </button>
            <button type="button" data-action="clear-all-harvest-creatures">
              <i class="fa-solid fa-xmark"></i>
              Clear All
            </button>
          </div>

          <div class="ml-stack" data-gap="2">
            {{#each deadCreatures}}
              <label class="ml-actor-choice" title="Include {{name}} in this Harvest session">
                  <input
                    type="checkbox"
                    data-harvest-creature-select
                    data-token-uuid="{{tokenUuid}}"
                    {{checked selectedForHarvest}}
                  >
                <img class="ml-avatar" src="{{img}}" alt="">
                <span class="ml-stack" data-gap="1">
                  <strong>{{name}}</strong>
                  <small>
                    {{creatureType}} · CR {{cr}} · Harvest DC {{dc}}
                    {{#if harvestRarity}} · {{harvestRarity}}{{/if}}
                  </small>

                  {{#if specialItems.length}}
                    <div class="ml-craftworks-harvest-special-harvest-items">
                      <div class="ml-craftworks-harvest-special-harvest-heading">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        Special Harvest Items / Instructions
                      </div>
                      {{#each specialItems}}
                        <div class="ml-craftworks-harvest-special-harvest-instruction">
                          {{{html}}}
                        </div>
                      {{/each}}
                    </div>
                  {{/if}}
                </span>
              </label>
            {{/each}}
          </div>
        </section>

        <section class="ml-surface ml-section ml-stack" data-gap="3">
          <div class="ml-section-heading"><div><h2>Player Characters</h2><p>Characters participating in this Harvest.</p></div></div>

          <label class="ml-craftworks-harvest-skip-skill-row">
            <span class="ml-craftworks-harvest-skip-character">
              <i class="fa-solid fa-forward"></i>
              <span>
                <strong>Skip Skill Checks</strong>
                <small>All included characters proceed directly to their claimable components.</small>
              </span>
            </span>
            <input type="checkbox" data-skip-skill-check {{#if skipSkillChecks}}checked{{/if}}>
          </label>

          {{#if playerCharacters.length}}
            <div class="ml-actor-choice-grid">
              {{#each playerCharacters}}
                <label class="ml-actor-choice" data-harvest-character-row>
                  <input type="checkbox" name="characterUuid" value="{{actorUuid}}"
                    data-harvest-character-select {{#if selected}}checked{{/if}}>
                  <img src="{{actorImg}}" alt="{{actorName}}">
                  <span class="ml-stack" data-gap="1">
                    <strong>{{actorName}}</strong>
                    <small>{{#if connected}}{{userName}}{{else}}Offline · Not connected{{/if}}</small>
                  </span>
                </label>
              {{/each}}
            </div>
          {{else}}
          <div class="ml-text ml-craftworks-harvest-harvest-message ml-craftworks-warning" data-tone="warning">
              No active player characters were found.
            </div>
          {{/if}}
        </section>
      {{else}}
        <section class="ml-craftworks-harvest-empty">
          <i class="fa-solid fa-scalpel"></i>
          <h2>No Dead Creatures</h2>
          <p>No defeated NPC tokens were found on the current scene.</p>
        </section>
      {{/if}}
    {{/if}}
  </main>

  <footer class="ml-page-footer ml-actions">
    <div class="ml-craftworks-harvest-footer-status">{{#if session}}Harvest session active{{else}}Ready to scan the scene{{/if}}</div>
    <div class="ml-actions">
      {{#if session}}
        <button
          type="button"
          class="ml-craftworks-harvest-cancel-harvest"
          data-action="cancel-harvest"
        >
          <i class="fa-solid fa-ban"></i> Cancel Harvest
        </button>
        <button
          type="button"
          class="ml-craftworks-harvest-finalize"
          data-action="finalize"
        >
          <i class="fa-solid fa-box-open"></i> Finalize Harvest
        </button>
      {{else if deadCreatures.length}}
        <button type="button" data-action="start">
          <i class="fa-solid fa-scalpel"></i> Start Harvest
        </button>
      {{/if}}
    </div>
  </footer>
</div>
