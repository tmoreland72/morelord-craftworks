<section class="mcw app-shell mcw-browser-shell">
  <header class="mcw-header">
    <h2>Treasure Hoard</h2>
    <p>Create accumulated treasure for a lair, vault, cache, strongbox, treasure room, or similar location.</p>
  </header>

  {{#unless result}}
    <div class="mcw-panel">
      <label>
        Hoard Challenge Tier
        <select name="profile">
          {{#each profiles}}
            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>

      <p class="mcw-muted">Higher tiers generate substantially more coin, more Craftworks material rolls, and a greater chance of special treasure.</p>

      <button type="button" data-action="roll">
        <i class="fa-solid fa-dice-d20"></i> Generate Hoard
      </button>
    </div>
  {{else}}
    <div class="mcw-browser-results">
      <div class="mcw-panel">
        <h3>{{result.profileLabel}} Hoard</h3>

        <div class="mcw-result-toolbar">
          <button type="button" data-action="delete-result-items"><i class="fa-solid fa-trash"></i> Delete Marked</button>
          <button type="button" data-action="open-item-lookup"><i class="fa-solid fa-plus"></i> Add Item</button>
        </div>

        {{#if itemLookupOpen}}
          <div class="mcw-item-lookup">
            <div class="mcw-item-lookup-header">
              <div><strong>Add an Item</strong><small>Search enabled D&amp;D Item compendiums.</small></div>
              <button type="button" class="mcw-icon-button" data-action="close-item-lookup" title="Close item lookup"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="mcw-item-lookup-search">
              <i class="fa-solid fa-magnifying-glass"></i>
              <input type="search" data-item-search value="{{itemSearchQuery}}" placeholder="Type at least 2 characters…" autocomplete="off">
            </div>
            {{#if itemSearchResults.length}}
              <div class="mcw-item-search-results">
                {{#each itemSearchResults}}
                  <button type="button" data-action="add-result-item" data-item-uuid="{{uuid}}"><img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>{{sourceLabel}}{{#if type}} · {{type}}{{/if}}</small></span><i class="fa-solid fa-plus"></i></button>
                {{/each}}
              </div>
            {{else}}
              {{#if itemSearchReady}}
                <p class="mcw-item-lookup-empty">No matching Items found in enabled sources.</p>
              {{else}}
                <p class="mcw-item-lookup-hint">Enter at least 2 characters to search.</p>
              {{/if}}
            {{/if}}
          </div>
        {{/if}}

        {{#if result.materials.length}}
          <div class="mcw-loot-summary-grid">
            {{#each result.materials}}
              <div class="mcw-result mcw-editable-result" data-document-uuid="{{uuid}}">
                <input type="checkbox" data-result-item="materials:{{@index}}" aria-label="Mark {{name}} for deletion">
                <img src="{{img}}" alt="{{name}}">
                <strong>{{name}} ×{{quantity}}</strong>
              </div>
            {{/each}}
          </div>
        {{/if}}

        <h4>Potions</h4>
        <div class="mcw-loot-summary-grid">{{#each result.potions}}<div class="mcw-result mcw-editable-result" data-document-uuid="{{uuid}}"><input type="checkbox" data-result-item="potions:{{@index}}" aria-label="Mark {{name}} for deletion"><img src="{{img}}" alt="{{name}}"><strong>{{name}}</strong></div>{{/each}}</div>

        <h4>Spell Scrolls</h4>
        <div class="mcw-loot-summary-grid">{{#each result.spellScrolls}}<div class="mcw-result mcw-editable-result" data-document-uuid="{{uuid}}"><input type="checkbox" data-result-item="spellScrolls:{{@index}}" aria-label="Mark Spell Scroll: {{name}} for deletion"><img src="{{img}}" alt="{{name}}"><strong>Spell Scroll: {{name}}</strong></div>{{/each}}</div>

        {{#if result.customItems.length}}
          <h4>Added Items</h4>
          <div class="mcw-loot-summary-grid">{{#each result.customItems}}<div class="mcw-result mcw-editable-result" data-document-uuid="{{uuid}}"><input type="checkbox" data-result-item="customItems:{{@index}}" aria-label="Mark {{name}} for deletion"><img src="{{img}}" alt="{{name}}"><div><strong>{{name}}</strong><small>{{sourceLabel}}</small></div></div>{{/each}}</div>
        {{/if}}

        <div class="mcw-coin-editor">
          <div class="mcw-coin-editor-heading">
            <strong><i class="fa-solid fa-coins"></i> Coin</strong>
            <span>{{#if result.coinCopper}}{{result.coinLabel}}{{else}}No coin{{/if}}</span>
          </div>
          <div class="mcw-coin-fields">
            {{#each coinEditor}}
              <label><span>{{label}}</span><input type="number" min="0" step="1" value="{{value}}" data-coin-denomination="{{denomination}}"></label>
            {{/each}}
          </div>
        </div>

        {{#if result.special.enabled}}
          <div class="mcw-special-treasure">
            <strong>Special Treasure</strong>
            {{#if result.special.triggered}}
              <p>
                Special treasure triggered ({{result.special.roll}} / {{result.special.chance}}%).
                Rolled 1d4 = <strong>{{result.special.itemCountRoll}}</strong> item(s).
              </p>

              {{#if result.special.items.length}}
                <div class="mcw-special-items">
                  {{#each result.special.items}}
                    <div class="mcw-result mcw-special-result mcw-editable-result" data-document-uuid="{{itemUuid}}">
                      <input type="checkbox" data-result-item="specialItems:{{@index}}" aria-label="Mark {{itemName}} for deletion">
                      <img src="{{itemImg}}" alt="{{itemName}}">
                      <div class="mcw-special-item-copy">
                        <strong>{{itemName}}</strong>
                        <span>{{sourceLabel}}</span>
                        {{#if rarity}}<span>{{rarity}}</span>{{/if}}
                      </div>
                      <button type="button"
                              class="mcw-icon-button mcw-special-item-open"
                              data-item-uuid="{{itemUuid}}"
                              title="Open {{itemName}} from its source compendium">
                        <i class="fa-solid fa-up-right-from-square"></i>
                      </button>
                    </div>
                  {{/each}}
                </div>
              {{/if}}

              {{#if result.special.detail}}
                <p class="mcw-warning">{{result.special.detail}}</p>
              {{/if}}
            {{else}}
              <p>No special treasure ({{result.special.roll}} / {{result.special.chance}}%).</p>
            {{/if}}
          </div>
        {{/if}}

      </div>

      <div class="mcw-panel">
        <h3>Recipient</h3>

        <label>
          Reward Recipient
          <select name="recipient">
            <option value="">Choose character or group…</option>
            {{#each actors}}
              <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>
            {{/each}}
          </select>
        </label>
        {{#if partyInfo.valid}}<p class="mcw-muted">The configured default is {{partyInfo.actorName}}.</p>{{/if}}

        <div class="mcw-actions">
          <button type="button" data-action="send-chat">
            <i class="fa-solid fa-message"></i> Send to Chat
          </button>
          <button type="button" data-action="reroll">
            <i class="fa-solid fa-dice"></i> Reroll Hoard
          </button>
          <button type="button" data-action="award" {{#unless result.found}}disabled{{/unless}}>
            <i class="fa-solid fa-box-open"></i> Award Hoard
          </button>
        </div>
      </div>
    </div>
  {{/unless}}
</section>
