<section class="ml-app ml-app-shell ml-craftworks app-shell ml-craftworks-browser-shell ml-craftworks-marketplace-browser">
  <header class="ml-hero"><i class="fa-solid fa-hammer ml-hero__icon"></i><div class="ml-hero__body"><h1>Materials</h1><p>Reference Craftworks materials, acquisition methods, values, recipes, and inventory quantities.</p></div>
  <div class="ml-actions"><button type="button" data-action="open-module-documentation"><i class="fa-solid fa-book-open"></i> Documentation</button></div></header>

  <div class="ml-craftworks-marketplace-browser-body">
    <aside class="ml-surface ml-craftworks-filter-rail ml-stack" data-gap="3">
      <div class="ml-section-heading"><div><h2>Filters</h2><p>Narrow the catalog to the entries you want to use.</p></div>
        <button type="button"
                class="ml-icon-button ml-craftworks-icon-button"
                data-action="clear-material-filters"
                aria-label="Clear all filters"
                title="Clear all filters">
          <i class="fa-solid fa-filter-circle-xmark"></i>
        </button>
      </div>

      <label class="ml-craftworks-filter-search">
        <span>Search</span>
        <input type="search"
               name="search"
               value="{{search}}"
               placeholder="Material, tag, category, source…">
      </label>

      <label class="ml-craftworks-filter-search">
        <span>Check Inventory</span>
        <select name="actor"><option value="">No inventory selected</option>{{#each actors}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
      </label>
      <label class="ml-craftworks-filter-checkbox"><input type="checkbox" name="ownedOnly" {{#if ownedOnly}}checked{{/if}} {{#unless actorName}}disabled{{/unless}}> <span>Owned only</span></label>

      <div class="ml-craftworks-market-filter-mode-legend">
        <span><i class="fa-regular fa-square"></i> Any</span>
        <span><i class="fa-solid fa-square-check"></i> Include</span>
        <span><i class="fa-solid fa-square-minus"></i> Exclude</span>
      </div>

      <section class="ml-section ml-craftworks-filter-group">
        <div class="ml-section-heading"><div><h2>Content Pack</h2><p>Include or exclude entries from enabled content packs.</p></div></div>
        <div class="ml-craftworks-tristate-list">
          {{#each packs}}
            <button type="button"
                    class="ml-craftworks-tristate-filter {{#if included}}is-include{{else if excluded}}is-exclude{{/if}}"
                    data-tristate-filter
                    data-filter-group="pack"
                    data-filter-value="{{id}}"
                    title="Click: include → exclude → neutral">
              <span>{{label}}</span>
              <small>{{materialCount}}</small>
              <i class="fa-solid {{#if included}}fa-plus{{else if excluded}}fa-minus{{else}}fa-circle{{/if}}"></i>
            </button>
          {{/each}}
        </div>
      </section>

      <section class="ml-section ml-craftworks-filter-group">
        <div class="ml-section-heading"><div><h2>Rarity</h2><p>Filter entries by rarity.</p></div></div>
        <div class="ml-craftworks-tristate-list">
          {{#each rarities}}
            <button type="button"
                    class="ml-craftworks-tristate-filter {{#if included}}is-include{{else if excluded}}is-exclude{{/if}}"
                    data-tristate-filter
                    data-filter-group="rarity"
                    data-filter-value="{{id}}">
              <span>{{label}}</span>
              <i class="fa-solid {{#if included}}fa-plus{{else if excluded}}fa-minus{{else}}fa-circle{{/if}}"></i>
            </button>
          {{/each}}
        </div>
      </section>

      {{#each tagGroups}}
      <section class="ml-section ml-craftworks-filter-group ml-craftworks-filter-subsection">
        <div class="ml-section-heading"><div><h2>{{label}}</h2><p>Browse the entries in this group.</p></div></div>
        <div class="ml-craftworks-tristate-list">
          {{#each options}}
            <button type="button"
                    class="ml-craftworks-tristate-filter {{#if included}}is-include{{else if excluded}}is-exclude{{/if}}"
                    data-tristate-filter
                    data-filter-group="tag"
                    data-filter-value="{{id}}">
              <span>{{label}}</span>
              <i class="fa-solid {{#if included}}fa-plus{{else if excluded}}fa-minus{{else}}fa-circle{{/if}}"></i>
            </button>
          {{/each}}
        </div>
      </section>
      {{/each}}

</aside>

    <main class="ml-surface ml-craftworks-marketplace-results ml-stack" data-gap="3">
      <div class="ml-section-heading"><div><h2>Materials</h2><p>Browse the entries matching the selected filters.</p></div><span>{{prospectiveCount}} matches</span></div>

      {{#if overDisplayLimit}}
        <div class="ml-craftworks-market-limit-message">
          <i class="fa-solid fa-filter"></i>
          <div>
            <strong>{{prospectiveCount}} materials match the current filters.</strong>
            <span>
              Showing the first <strong>{{displayLimit}}</strong>. Filter totals continue
              to reflect all available matching materials.
            </span>
          </div>
        </div>
      {{/if}}
        <div class="ml-craftworks-reference-list ml-craftworks-browser-results">
          {{#each materials}}
      <article class="ml-card ml-craftworks-reference-card ml-craftworks-material-card {{#if owned}}ml-craftworks-material-owned{{/if}} {{#if focused}}ml-craftworks-material-focused{{/if}}" data-document-uuid="{{uuid}}">
        <img src="{{img}}" alt="{{name}}">

        <div class="ml-craftworks-reference-main">
          <div class="ml-craftworks-reference-title">
            <strong>{{name}}</strong>
            <span>{{rarity}} • {{category}} • {{packLabel}}</span>
          </div>

          <div class="ml-craftworks-pills">
            {{#if ../actorName}}
              <span class="ml-craftworks-owned-pill">
                Owned: {{ownedQuantity}}
              </span>
            {{/if}}

            {{#if acquisition.gatherable}}<span>Gather</span>{{/if}}
            {{#if acquisition.harvestable}}<span>Harvest</span>{{/if}}
            {{#if acquisition.lootable}}<span>Loot</span>{{/if}}
            {{#if purchasable}}<span>Purchasable</span>{{/if}}
            <span>{{priceLabel}}</span>
          </div>

          {{#if tags.length}}
            <p>
              <strong>Tags:</strong>
              {{#each tags}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
            </p>
          {{/if}}

          {{#if producedBy.length}}
            <p>
              <strong>Produced by:</strong>
              {{#each producedBy}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
            </p>
          {{/if}}

          {{#if usedIn.length}}
            <p>
              <strong>Used in:</strong>
              {{#each usedIn}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
            </p>
          {{/if}}
        </div>
      </article>
          {{else}}
            <div class="ml-empty-state">
              <p>No materials match the current filters.</p>
            </div>
          {{/each}}
        </div>
    </main>
  </div>
</section>
