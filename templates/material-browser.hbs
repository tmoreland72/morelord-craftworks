<section class="mcw app-shell mcw-browser-shell mcw-marketplace-browser">
  <header class="mcw-header">
    <div>
      <h2>Materials</h2>
      <p>Reference Craftworks materials, acquisition methods, values, recipes, and inventory quantities.</p>
    </div>
  </header>

  <div class="mcw-marketplace-browser-body">
    <aside class="mcw-filter-rail">
      <div class="mcw-market-filter-title">
        <strong>Filters</strong>
        <button type="button"
                class="mcw-icon-button"
                data-action="clear-material-filters"
                title="Clear all filters">
          <i class="fa-solid fa-filter-circle-xmark"></i>
        </button>
      </div>

      <label class="mcw-filter-search">
        <span>Search</span>
        <input type="search"
               name="search"
               value="{{search}}"
               placeholder="Material, tag, category, source…">
      </label>

      <div class="mcw-market-filter-mode-legend">
        <span><i class="fa-regular fa-square"></i> Any</span>
        <span><i class="fa-solid fa-square-check"></i> Include</span>
        <span><i class="fa-solid fa-square-minus"></i> Exclude</span>
      </div>

      <section class="mcw-filter-group">
        <h3>Content Pack</h3>
        <div class="mcw-tristate-list">
          {{#each packs}}
            <button type="button"
                    class="mcw-tristate-filter {{#if included}}is-include{{else if excluded}}is-exclude{{/if}}"
                    data-tristate-filter
                    data-filter-group="pack"
                    data-filter-value="{{id}}"
                    title="Click: include → exclude → neutral">
              <span>{{label}}</span>
              <small>{{materialCount}}</small>
              <i class="fa-solid {{#if included}}fa-plus{{else if excluded}}fa-minus{{else}}fa-circle{{/if}}"></i>
            </button>
          {{/each}}
        </div>
      </section>

      <section class="mcw-filter-group">
        <h3>Rarity</h3>
        <div class="mcw-tristate-list">
          {{#each rarities}}
            <button type="button"
                    class="mcw-tristate-filter {{#if included}}is-include{{else if excluded}}is-exclude{{/if}}"
                    data-tristate-filter
                    data-filter-group="rarity"
                    data-filter-value="{{id}}">
              <span>{{label}}</span>
              <i class="fa-solid {{#if included}}fa-plus{{else if excluded}}fa-minus{{else}}fa-circle{{/if}}"></i>
            </button>
          {{/each}}
        </div>
      </section>

      <section class="mcw-filter-group">
        <h3>Tags</h3>
        <div class="mcw-tristate-list">
          {{#each tags}}
            <button type="button"
                    class="mcw-tristate-filter {{#if included}}is-include{{else if excluded}}is-exclude{{/if}}"
                    data-tristate-filter
                    data-filter-group="tag"
                    data-filter-value="{{id}}">
              <span>{{label}}</span>
              <i class="fa-solid {{#if included}}fa-plus{{else if excluded}}fa-minus{{else}}fa-circle{{/if}}"></i>
            </button>
          {{/each}}
        </div>
      </section>

      <label class="mcw-filter-search">
        <span>Check Inventory</span>
        <select name="actor">
          <option value="">No inventory selected</option>
          {{#each actors}}
            <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
      </label>
</aside>

    <main class="mcw-marketplace-results">
      <div class="mcw-market-results-heading">
        <h2>Materials</h2>
        <span>{{prospectiveCount}} matches</span>
      </div>

      {{#if overDisplayLimit}}
        <div class="mcw-market-limit-message">
          <i class="fa-solid fa-filter"></i>
          <div>
            <strong>{{prospectiveCount}} materials match the current filters.</strong>
            <span>
              Refine the filters or search until there are
              <strong>{{displayLimit}} or fewer</strong> results before items are displayed.
            </span>
          </div>
        </div>
      {{else}}
        <div class="mcw-reference-list mcw-browser-results">
          {{#each materials}}
      <article class="mcw-reference-card mcw-material-card {{#if owned}}mcw-material-owned{{/if}} {{#if focused}}mcw-material-focused{{/if}}">
        <img src="{{img}}" alt="{{name}}">

        <div class="mcw-reference-main">
          <div class="mcw-reference-title">
            <strong>{{name}}</strong>
            <span>{{rarity}} • {{category}} • {{packLabel}}</span>
          </div>

          <div class="mcw-pills">
            {{#if ../actorName}}
              <span class="mcw-owned-pill">
                Owned: {{ownedQuantity}}
              </span>
            {{/if}}

            {{#if acquisition.gatherable}}<span>Gather</span>{{/if}}
            {{#if acquisition.harvestable}}<span>Harvest</span>{{/if}}
            {{#if acquisition.lootable}}<span>Loot</span>{{/if}}
            {{#if purchasable}}<span>Purchasable</span>{{/if}}
            <span>{{priceLabel}}</span>
          </div>

          {{#if tags.length}}
            <p>
              <strong>Tags:</strong>
              {{#each tags}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
            </p>
          {{/if}}

          {{#if producedBy.length}}
            <p>
              <strong>Produced by:</strong>
              {{#each producedBy}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
            </p>
          {{/if}}

          {{#if usedIn.length}}
            <p>
              <strong>Used in:</strong>
              {{#each usedIn}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
            </p>
          {{/if}}
        </div>
      </article>
          {{else}}
            <div class="mcw-panel">
              <p>No materials match the current filters.</p>
            </div>
          {{/each}}
        </div>
      {{/if}}
    </main>
  </div>
</section>
