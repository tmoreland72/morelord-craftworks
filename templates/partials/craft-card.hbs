<article class="ml-craftworks-craft-card">
  <header class="ml-craftworks-craft-card-header">
    <div class="ml-craftworks-craft-card-title">
      {{#if output.img}}
        {{#if outputDocumentUuid}}
          <button type="button"
                  class="ml-craftworks-craft-card-image"
                  data-output-document-uuid="{{outputDocumentUuid}}"
                  title="Open source Item">
            <img src="{{output.img}}" alt="{{name}}">
          </button>
        {{else}}
          <img class="ml-craftworks-craft-card-image-static"
               src="{{output.img}}"
               alt="{{name}}">
        {{/if}}
      {{/if}}

      <div>
        <h3>{{name}}</h3>
        <div class="ml-craftworks-recipe-meta">
          <span>{{sourceLabel}}</span>
          {{#if tags.length}}
            {{#each tags}}<span>{{this}}</span>{{/each}}
          {{/if}}
        </div>
      </div>
    </div>

    <button type="button"
            class="ml-craftworks-button-subtle"
            data-action="unmark"
            data-recipe-id="{{id}}"
            {{#if isActive}}disabled{{/if}}
            title="Remove from Craft list">
      <i class="fa-solid fa-bookmark"></i>
      Remove
    </button>
  </header>

  <div class="ml-craftworks-craft-card-meta">
    {{#if craftMeta.tool}}
      <span>
        <i class="fa-solid fa-screwdriver-wrench"></i>
        {{craftMeta.tool}}
      </span>
    {{/if}}
    {{#if craftMeta.check}}
      <span>
        <i class="fa-solid fa-dice-d20"></i>
        {{craftMeta.check}}
        {{#if craftMeta.activeDc}} · DC {{craftMeta.activeDc}}{{/if}}
      </span>
    {{/if}}
    {{#if craftMeta.hoursRequired}}
      <span>
        <i class="fa-solid fa-clock"></i>
        {{craftMeta.hoursRequired}} hours
      </span>
    {{/if}}
  </div>

  {{#if progress}}
    <div class="ml-craftworks-craft-progress-large">
      <div>
        <strong>{{progress.successes}} of {{progress.requiredSuccesses}} Successes</strong>
        <span>{{progress.progressHours}} of {{progress.hoursRequired}} hours progress</span>
      </div>
      <span>{{progress.timeSpentHours}} hours spent</span>
    </div>
  {{/if}}

  <div class="ml-craftworks-craft-card-body">
    <section>
      <h4>Requirements</h4>
      {{#if requirementsKnown}}
        <div class="ml-craftworks-craft-requirements">
          {{#each requirementGroupRows}}
          <div class="ml-craftworks-craft-requirement-group">
            {{#each requirementRows}}
              {{#if alternativeRows.length}}
                <div class="ml-craftworks-craft-alternative-group">
                  <strong>Choose one:</strong>
                  {{#each alternativeRows}}
                    <div class="ml-craftworks-craft-requirement-row {{#if inventory.ready}}ml-craftworks-ready{{else}}ml-craftworks-missing{{/if}}" data-document-uuid="{{materialUuid}}">
                      {{#if materialImg}}
                        {{#if materialId}}
                          <button type="button"
                                  data-material-id="{{materialId}}"
                                  class="ml-craftworks-material-icon-link">
                            <img src="{{materialImg}}" alt="">
                          </button>
                        {{else}}
                          <span class="ml-craftworks-material-icon-link ml-craftworks-material-icon-display">
                            <img src="{{materialImg}}" alt="">
                          </span>
                        {{/if}}
                      {{/if}}
                      <span class="ml-craftworks-requirement-copy">
          <strong>{{displayLabel}}</strong>
          {{#if displayRarity}}
            <small class="ml-craftworks-requirement-rarity">{{displayRarity}}</small>
          {{/if}}
        </span>
                      {{#if inventory}}
                        <strong>{{inventory.available}} / {{inventory.required}}</strong>
                      {{/if}}
                    </div>
                  {{/each}}
                </div>
              {{else}}
                <div class="ml-craftworks-craft-requirement-row {{#if inventory.ready}}ml-craftworks-ready{{else}}ml-craftworks-missing{{/if}}" data-document-uuid="{{materialUuid}}">
                  {{#if materialImg}}
                    {{#if materialId}}
                      <button type="button"
                              data-material-id="{{materialId}}"
                              class="ml-craftworks-material-icon-link">
                        <img src="{{materialImg}}" alt="">
                      </button>
                    {{else}}
                      <span class="ml-craftworks-material-icon-link ml-craftworks-material-icon-display">
                        <img src="{{materialImg}}" alt="">
                      </span>
                    {{/if}}
                  {{/if}}
                  <span class="ml-craftworks-requirement-copy">
          <strong>{{displayLabel}}</strong>
          {{#if displayRarity}}
            <small class="ml-craftworks-requirement-rarity">{{displayRarity}}</small>
          {{/if}}
        </span>
                  {{#if inventory}}
                    <strong>{{inventory.available}} / {{inventory.required}}</strong>
                  {{/if}}
                </div>
              {{/if}}
            {{/each}}
          </div>
          {{#unless @last}}<div class="ml-craftworks-requirement-group-or">OR</div>{{/unless}}
          {{/each}}
        </div>
      {{else}}
        <div class="ml-craftworks-recipe-unknown-requirements">
          <i class="fa-solid fa-circle-question"></i>
          <div>
            <strong>Ingredients Unknown</strong>
            <span>Discover this recipe's ingredients before crafting can begin.</span>
          </div>
        </div>
      {{/if}}
    </section>

    <section class="ml-craftworks-craft-output-panel">
      <h4>Produces</h4>
      <div class="ml-craftworks-craft-output">
        {{#if output.img}}
          <img src="{{output.img}}" alt="{{output.label}}">
        {{/if}}
        <div>
          <strong>{{output.label}}</strong>
          <span>×{{output.quantity}}</span>
        </div>
      </div>
    </section>
  </div>

  <footer class="ml-craftworks-craft-card-actions">
    {{#if isCompletePending}}
      <span class="ml-craftworks-crafting-complete">
        <i class="fa-solid fa-trophy"></i>
        Crafting Complete
      </span>
      <button type="button"
              data-action="choose-destination"
              data-recipe-id="{{id}}">
        <i class="fa-solid fa-box-open"></i>
        Choose Destination
      </button>
    {{else}}
      {{#if isActive}}
        <span class="ml-craftworks-muted">
          Materials were consumed from {{inventoryActorName}}.
        </span>
        <button type="button"
                data-action="craft"
                data-recipe-id="{{id}}">
          <i class="fa-solid fa-dice-d20"></i>
          Roll Crafting Check
        </button>
        <button type="button"
                class="ml-craftworks-button-subtle"
                data-action="cancel-crafting"
                data-recipe-id="{{id}}">
          <i class="fa-solid fa-ban"></i>
          Cancel
        </button>
      {{else}}
        {{#if requirementsKnown}}
        {{#if readiness.ready}}
          <span class="ml-craftworks-craft-ready-label">
            <i class="fa-solid fa-circle-check"></i>
            Ready to Craft
          </span>
          <button type="button"
                  data-action="craft"
                  data-recipe-id="{{id}}">
            <i class="fa-solid fa-hammer"></i>
            Start Crafting
          </button>
        {{else}}
          <span class="ml-craftworks-craft-missing-label">
            <i class="fa-solid fa-circle-xmark"></i>
            Missing Requirements
          </span>
        {{/if}}
      {{else}}
        <span class="ml-craftworks-craft-missing-label">
          <i class="fa-solid fa-circle-question"></i>
          Ingredients Unknown
        </span>
      {{/if}}
      {{/if}}
    {{/if}}
  </footer>
</article>
