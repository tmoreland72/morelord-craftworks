<section class="ml-app ml-app-shell ml-craftworks app-shell ml-craftworks-browser-shell ml-craftworks-marketplace-browser">
  <header class="ml-hero"><i class="fa-solid fa-hammer ml-hero__icon"></i><div class="ml-hero__body"><h1>Recipes</h1><p>Browse recipes, discover requirements, and mark recipes for Craft.</p></div>
  <div class="ml-actions"><button type="button" data-action="open-module-documentation"><i class="fa-solid fa-book-open"></i> Documentation</button></div></header>

  <div class="ml-craftworks-marketplace-browser-body">
    <aside class="ml-surface ml-craftworks-filter-rail ml-stack" data-gap="3">
      <div class="ml-section-heading"><div><h2>Filters</h2><p>Narrow the catalog to the entries you want to use.</p></div>
        <button type="button"
                class="ml-icon-button ml-craftworks-icon-button"
                data-action="clear-recipe-filters"
                aria-label="Clear all filters"
                title="Clear all filters">
          <i class="fa-solid fa-filter-circle-xmark"></i>
        </button>
      </div>

      <label class="ml-craftworks-filter-search">
        <span>Search</span>
        <input type="search"
               name="search"
               value="{{search}}"
               placeholder="Recipe, source, category…">
      </label>

      <div class="ml-craftworks-market-filter-mode-legend">
        <span><i class="fa-regular fa-square"></i> Any</span>
        <span><i class="fa-solid fa-square-check"></i> Include</span>
        <span><i class="fa-solid fa-square-minus"></i> Exclude</span>
      </div>

      <section class="ml-section ml-craftworks-filter-group">
        <div class="ml-section-heading"><div><h2>Knowledge</h2><p>Filter recipes by the selected character’s knowledge.</p></div></div>
        <div class="ml-craftworks-tristate-list">
          {{#each knowledgeFilters}}
            <button type="button"
                    class="ml-craftworks-tristate-filter {{#if included}}is-include{{else if excluded}}is-exclude{{/if}}"
                    data-tristate-filter
                    data-filter-group="knowledge"
                    data-filter-value="{{id}}">
              <span>{{label}}</span>
              <small>{{count}}</small>
              <i class="fa-solid {{#if included}}fa-plus{{else if excluded}}fa-minus{{else}}fa-circle{{/if}}"></i>
            </button>
          {{/each}}
        </div>
      </section>

      <section class="ml-section ml-craftworks-filter-group">
        <div class="ml-section-heading"><div><h2>Content Pack</h2><p>Include or exclude entries from enabled content packs.</p></div></div>
        <div class="ml-craftworks-tristate-list">
          {{#each packs}}
            <button type="button"
                    class="ml-craftworks-tristate-filter {{#if included}}is-include{{else if excluded}}is-exclude{{/if}}"
                    data-tristate-filter
                    data-filter-group="pack"
                    data-filter-value="{{id}}">
              <span>{{label}}</span>
              <small>{{recipeCount}}</small>
              <i class="fa-solid {{#if included}}fa-plus{{else if excluded}}fa-minus{{else}}fa-circle{{/if}}"></i>
            </button>
          {{/each}}
        </div>
      </section>

      <section class="ml-section ml-craftworks-filter-group">
        <div class="ml-section-heading"><div><h2>Category</h2><p>Filter the available entries by category.</p></div></div>
        <div class="ml-craftworks-tristate-list">
          {{#each categories}}
            <button type="button"
                    class="ml-craftworks-tristate-filter {{#if included}}is-include{{else if excluded}}is-exclude{{/if}}"
                    data-tristate-filter
                    data-filter-group="category"
                    data-filter-value="{{id}}">
              <span>{{label}}</span>
              <small>{{count}}</small>
              <i class="fa-solid {{#if included}}fa-plus{{else if excluded}}fa-minus{{else}}fa-circle{{/if}}"></i>
            </button>
          {{/each}}
        </div>
      </section>

      <section class="ml-section ml-craftworks-filter-group">
        <div class="ml-section-heading"><div><h2>Preferred Artisan Tool</h2><p>Filter recipes by their preferred crafting tool.</p></div></div>
        <div class="ml-craftworks-tristate-list">
          {{#each toolFilters}}
            <button type="button"
                    class="ml-craftworks-tristate-filter {{#if included}}is-include{{else if excluded}}is-exclude{{/if}}"
                    data-tristate-filter
                    data-filter-group="tool"
                    data-filter-value="{{id}}">
              <span>{{label}}{{#if proficient}} <i class="fa-solid fa-circle-check" title="Character is proficient"></i>{{/if}}</span>
              <small>{{count}}</small>
              <i class="fa-solid {{#if included}}fa-plus{{else if excluded}}fa-minus{{else}}fa-circle{{/if}}"></i>
            </button>
          {{/each}}
        </div>
      </section>

      <section class="ml-section ml-craftworks-filter-group">
        <div class="ml-section-heading"><div><h2>Rarity</h2><p>Filter entries by rarity.</p></div></div>
        <div class="ml-craftworks-tristate-list">
          {{#each ingredientRarities}}
            <button type="button"
                    class="ml-craftworks-tristate-filter {{#if included}}is-include{{else if excluded}}is-exclude{{/if}}"
                    data-tristate-filter
                    data-filter-group="rarity"
                    data-filter-value="{{id}}">
              <span>{{label}}</span>
              <small>{{count}}</small>
              <i class="fa-solid {{#if included}}fa-plus{{else if excluded}}fa-minus{{else}}fa-circle{{/if}}"></i>
            </button>
          {{/each}}
        </div>
      </section>

      {{#each ingredientTagGroups}}
      <section class="ml-section ml-craftworks-filter-group ml-craftworks-filter-subsection">
        <div class="ml-section-heading"><div><h2>{{label}}</h2><p>Browse the entries in this group.</p></div></div>
        <div class="ml-craftworks-tristate-list">
          {{#each options}}
            <button type="button"
                    class="ml-craftworks-tristate-filter {{#if included}}is-include{{else if excluded}}is-exclude{{/if}}"
                    data-tristate-filter
                    data-filter-group="tag"
                    data-filter-value="{{id}}">
              <span>{{label}}</span>
              <small>{{count}}</small>
              <i class="fa-solid {{#if included}}fa-plus{{else if excluded}}fa-minus{{else}}fa-circle{{/if}}"></i>
            </button>
          {{/each}}
        </div>
      </section>
      {{/each}}
</aside>

    <main class="ml-surface ml-craftworks-marketplace-results ml-stack" data-gap="3">
      {{#if canManageRecipeVisibility}}
        <div class="ml-craftworks-recipe-visibility-toolbar">
          <span>
            <i class="fa-solid fa-circle-question"></i>
            {{unknownRecipeCount}} recipe(s) with unknown ingredients
          </span>
          <div class="ml-actions">
            <button type="button" data-action="mark-all-recipes-unknown">
              <i class="fa-solid fa-circle-question"></i> Mark Context Unknown
            </button>
            <button type="button" data-action="mark-all-recipes-known">
              <i class="fa-solid fa-circle-check"></i> Mark Context Known
            </button>
          </div>
        </div>
      {{/if}}

      <div class="ml-section-heading"><div><h2>Recipes</h2><p>Browse the entries matching the selected filters.</p></div><span>{{prospectiveCount}} matches</span></div>

      {{#if overDisplayLimit}}
        <div class="ml-craftworks-market-limit-message">
          <i class="fa-solid fa-filter"></i>
          <div>
            <strong>{{prospectiveCount}} recipes match the current filters.</strong>
            <span>
              Showing the first <strong>{{displayLimit}}</strong>. Filter totals continue
              to reflect all available matching recipes.
            </span>
          </div>
        </div>
      {{/if}}
  <div class="ml-surface ml-section ml-craftworks-panel ml-craftworks-recipe-mark-context ml-stack" data-gap="3">
    <div class="ml-section-heading"><div><h2>Crafting Character</h2><p>Choose the character whose crafting list you want to manage.</p></div></div>
    <label class="ml-craftworks-recipe-crafter-selector">
      <span>Mark recipes for</span>
      <select name="crafter">
        <option value="">Choose character…</option>
        {{#each crafterActors}}
          <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
    </label>
    {{#if canMarkRecipes}}
      <span>Marked recipes will appear in <strong>{{crafterName}}'s Craft</strong> workspace.</span>
      <div class="ml-actions">
        <button type="button" data-action="mark-all-for-crafting"><i class="fa-solid fa-bookmark"></i> Mark All for Crafting</button>
      </div>
    {{/if}}
  </div>

  <div class="ml-craftworks-reference-list ml-craftworks-browser-results">
      {{#if hasRecipes}}
        {{#if hasToolChecks}}<p class="hint">Tool checks have disadvantage if the crafter lacks the tool in inventory or its proficiency. The DC stays the same.</p>{{/if}}
        {{#each recipeGroups}}
          <section class="ml-craftworks-recipe-category-group">
            <div class="ml-section-heading"><div><h2>{{label}}</h2><p>Browse the entries in this group.</p></div></div>
            <div class="ml-craftworks-recipe-category-list">
              {{#each recipes}}
                <article class="ml-card ml-craftworks-recipe-card">
                  <header class="ml-craftworks-recipe-header">
                    <div class="ml-craftworks-recipe-heading">
                      <div class="ml-craftworks-recipe-title-line">
                        <h3>{{name}}</h3>
                      </div>

                      <div class="ml-craftworks-recipe-meta">
                        <span>{{sourceLabel}}</span>
                      </div>
                    </div>

                    <div class="ml-craftworks-recipe-title-actions">
                      {{#if ../../canManageRecipeVisibility}}
                        <button type="button"
                                class="ml-craftworks-recipe-title-button {{#if isUnknown}}ml-craftworks-recipe-hidden{{else}}is-active{{/if}}"
                                data-action="toggle-recipe-knowledge"
                                data-recipe-id="{{id}}"
                                title="{{#if isUnknown}}Ingredients are unknown to players{{else}}Ingredients are known to players{{/if}}">
                          {{#if isUnknown}}<i class="fa-regular fa-square"></i> Unknown{{else}}<i class="fa-solid fa-square-check"></i> Known{{/if}}
                        </button>
                      {{/if}}
                      <button type="button"
                              class="ml-craftworks-recipe-title-button {{#if isMarked}}ml-craftworks-recipe-marked is-active{{/if}}"
                              data-action="toggle-mark-recipe"
                              data-recipe-id="{{id}}"
                              {{#unless canMark}}disabled{{/unless}}>
                        <i class="fa-{{#if isMarked}}solid{{else}}regular{{/if}} fa-bookmark"></i> {{markActionLabel}}
                      </button>
                    </div>
                  </header>

                  {{#if description}}
                    <p class="ml-craftworks-recipe-description">{{description}}</p>
                  {{/if}}

                  <div class="ml-craftworks-recipe-craft-meta">
                    {{#unless craftMeta.check}}{{#if craftMeta.tool}}
                      <span>
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                        <strong>Tool:</strong> {{craftMeta.tool}}
                      </span>
                    {{/if}}{{/unless}}
                    {{#if craftMeta.check}}
                      <span>
                        <i class="fa-solid fa-dice-d20"></i>
                        <strong>Check:</strong> {{craftMeta.check}}
                        {{#if craftMeta.dc}} · DC {{craftMeta.dc}}{{/if}}
                      </span>
                    {{/if}}
                    {{#if craftMeta.hoursRequired}}
                      <span>
                        <i class="fa-solid fa-clock"></i>
                        {{craftMeta.hoursRequired}} hours
                      </span>
                    {{/if}}
                    <span><i class="fa-solid fa-building"></i><strong>Facility:</strong> {{#if craftMeta.facilityType}}{{craftMeta.facilityTier}} or higher {{craftMeta.facilityType}}{{else}}No facility required{{/if}}</span>
                  </div>

                  <div class="ml-craftworks-recipe-grid">
                    <section class="ml-craftworks-recipe-block">
                      <h4>Requires</h4>
                      {{#if requirementsKnown}}
                        <div class="ml-craftworks-requirement-list ml-craftworks-requirement-groups">
                          {{#each requirementGroupRows}}
                          <div class="ml-craftworks-requirement-group">
                            <div class="ml-craftworks-requirement-group-items">
                              {{#each requirementRows}}
                                {{#if alternativeRows.length}}
                                  <div class="ml-craftworks-requirement-alternatives">
                                    <span class="ml-craftworks-requirement-alternatives-label">Choose one</span>
                                    {{#each alternativeRows}}
                                      <div class="ml-craftworks-requirement-row" data-document-uuid="{{materialUuid}}">
                                        {{#if materialImg}}
                                          {{#if materialId}}
                                            <button type="button"
                                                    class="ml-craftworks-material-icon-link"
                                                    data-material-id="{{materialId}}">
                                              <img src="{{materialImg}}" alt="">
                                            </button>
                                          {{else if materialUuid}}
                                            <button type="button"
                                                    class="ml-craftworks-material-icon-link"
                                                    data-document-uuid="{{materialUuid}}">
                                              <img src="{{materialImg}}" alt="">
                                            </button>
                                          {{else}}
                                            <span class="ml-craftworks-material-icon-link ml-craftworks-material-icon-display">
                                              <img src="{{materialImg}}" alt="">
                                            </span>
                                          {{/if}}
                                        {{/if}}
                                        <span class="ml-craftworks-requirement-copy">
                                          <span class="ml-craftworks-requirement-quantity">{{quantity}} ×</span>
                                          <strong>{{displayLabel}}</strong>
                                          {{#if displayRarity}}
                                            <small class="ml-craftworks-requirement-rarity">{{displayRarity}}</small>
                                          {{/if}}
                                        </span>
                                        {{#unless @last}}<span class="ml-craftworks-requirement-or">OR</span>{{/unless}}
                                      </div>
                                    {{/each}}
                                  </div>
                                {{else}}
                                  <div class="ml-craftworks-requirement-row" data-document-uuid="{{materialUuid}}">
                                    {{#if materialImg}}
                                      {{#if materialId}}
                                        <button type="button"
                                                class="ml-craftworks-material-icon-link"
                                                data-material-id="{{materialId}}">
                                          <img src="{{materialImg}}" alt="">
                                        </button>
                                      {{else if materialUuid}}
                                        <button type="button"
                                                class="ml-craftworks-material-icon-link"
                                                data-document-uuid="{{materialUuid}}">
                                          <img src="{{materialImg}}" alt="">
                                        </button>
                                      {{else}}
                                        <span class="ml-craftworks-material-icon-link ml-craftworks-material-icon-display">
                                          <img src="{{materialImg}}" alt="">
                                        </span>
                                      {{/if}}
                                    {{/if}}
                                    <span class="ml-craftworks-requirement-copy">
                                      <span class="ml-craftworks-requirement-quantity">{{quantity}} ×</span>
                                      <strong>{{displayLabel}}</strong>
                                      {{#if displayRarity}}
                                        <small class="ml-craftworks-requirement-rarity">{{displayRarity}}</small>
                                      {{/if}}
                                    </span>
                                  </div>
                                {{/if}}
                              {{/each}}
                            </div>
                          </div>
                          {{#unless @last}}
                            <div class="ml-craftworks-requirement-group-or">OR</div>
                          {{/unless}}
                          {{/each}}
                        </div>
                      {{else}}
                        <div class="ml-craftworks-recipe-unknown-requirements">
                          <i class="fa-solid fa-circle-question"></i>
                          <div>
                            <strong>Ingredients Unknown</strong>
                            <span>This recipe is known, but its required ingredients have not been discovered yet.</span>
                          </div>
                        </div>
                      {{/if}}
                    </section>

                    <section class="ml-craftworks-recipe-block">
                      <h4>Produces</h4>
                      <div class="ml-card ml-craftworks-recipe-output-card ml-craftworks-recipe-output-compact" data-document-uuid="{{outputDocumentUuid}}">
                        {{#if output.img}}
                          {{#if outputMaterialId}}
                            <button type="button"
                                    class="ml-craftworks-material-icon-link ml-craftworks-output-icon-link"
                                    data-material-id="{{outputMaterialId}}">
                              <img src="{{output.img}}" alt="">
                            </button>
                          {{else}}
                            {{#if outputDocumentUuid}}
                              <button type="button"
                                      class="ml-craftworks-foundry-output-link"
                                      data-output-document-uuid="{{outputDocumentUuid}}">
                                <img class="ml-craftworks-recipe-output-icon"
                                     src="{{output.img}}"
                                     alt="">
                              </button>
                            {{else}}
                              <img class="ml-craftworks-recipe-output-icon"
                                   src="{{output.img}}"
                                   alt="">
                            {{/if}}
                          {{/if}}
                        {{/if}}
                        <div>
                          <strong>{{output.label}}</strong>
                          {{#if output.showQuantity}}<span>×{{output.quantity}}</span>{{/if}}
                        </div>
                      </div>
                    </section>
                  </div>
                </article>
              {{/each}}
            </div>
          </section>
        {{/each}}
      {{else}}
        <div class="ml-empty-state">
          <p>No recipes match the current filters.</p>
        </div>
      {{/if}}
  </div>
    </main>
  </div>
</section>
