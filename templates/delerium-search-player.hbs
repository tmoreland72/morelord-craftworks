<section class="ml-app ml-app-shell ml-craftworks app-shell">
  <header class="ml-hero"><i class="fa-solid fa-hammer ml-hero__icon"></i><div class="ml-hero__body"><h1>Search for Delerium</h1><p>{{session.zone.name}} • DC {{session.zone.dc}} • {{session.sceneName}}</p></div><div class="ml-actions"><button type="button" data-action="open-module-documentation"><i class="fa-solid fa-book-open"></i> Documentation</button></div></header>
{{#if actor}}<div class="ml-craftworks-actor ml-craftworks-player-actor"><img src="{{actor.img}}" alt="{{actor.name}}"><strong>{{actor.name}}</strong></div>{{else}}<p class="ml-text ml-craftworks-warning" data-tone="warning">Select a token you own or configure a user character.</p>{{/if}}
  {{#if state}}<div class="ml-surface ml-section ml-craftworks-panel ml-stack" data-gap="3"><div class="ml-section-heading"><div><h2>Search Check</h2><p>Review or resolve your character’s search for delerium.</p></div></div>{{#if (eq state.status "declined")}}<p>You declined the search.</p>{{/if}}{{#if (eq state.status "failed")}}<p><strong>Failed.</strong> Your check total was {{state.total}}.</p>{{/if}}{{#if (eq state.status "succeeded")}}<p><strong>Success.</strong> Your check total was {{state.total}}, earning {{state.successes}} {{#if (eq state.successes 1)}}success{{else}}successes{{/if}}.</p>{{/if}}</div>{{else}}<div class="ml-surface ml-section ml-craftworks-panel ml-craftworks-player-roll-panel ml-stack" data-gap="3"><div class="ml-section-heading"><div><h2>Search Check</h2><p>Review or resolve your character’s search for delerium.</p></div></div><p class="notes">Choose one skill. A natural 20 or beating the DC by 5+ earns 2 successes.</p><div class="ml-craftworks-player-skill-grid">{{#each skills}}<button type="button" data-action="roll" data-skill="{{id}}"><i class="fa-solid fa-dice-d20"></i><span>{{label}}</span><strong>{{modifierLabel}}</strong></button>{{/each}}</div></div>{{/if}}
  <footer class="ml-page-footer ml-actions">{{#unless state}}<button class="ml-craftworks-player-decline" type="button" data-action="decline"><i class="fa-solid fa-ban"></i> Decline</button>{{/unless}}<button type="button" data-action="close"><i class="fa-solid fa-xmark"></i> Close</button></footer>
</section>
