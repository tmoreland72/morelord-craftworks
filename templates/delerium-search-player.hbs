<section class="mcw app-shell">
  <header class="mcw-header"><h2>Search for Delerium</h2><p>{{session.zone.name}} • DC {{session.zone.dc}} • {{session.sceneName}}</p></header>
  {{#if actor}}<div class="mcw-actor mcw-player-actor"><img src="{{actor.img}}" alt="{{actor.name}}"><strong>{{actor.name}}</strong></div>{{else}}<p class="mcw-warning">Select a token you own or configure a user character.</p>{{/if}}
  {{#if state}}<div class="mcw-panel">{{#if (eq state.status "declined")}}<p>You declined the search.</p>{{/if}}{{#if (eq state.status "failed")}}<p><strong>Failed.</strong> Your check total was {{state.total}}.</p>{{/if}}{{#if (eq state.status "succeeded")}}<p><strong>Success.</strong> Your check total was {{state.total}}, earning {{state.successes}} {{#if (eq state.successes 1)}}success{{else}}successes{{/if}}.</p>{{/if}}</div>{{else}}<div class="mcw-panel mcw-player-roll-panel"><p>Choose one skill. A natural 20 or beating the DC by 5+ earns 2 successes.</p><div class="mcw-player-skill-grid">{{#each skills}}<button type="button" data-action="roll" data-skill="{{id}}"><i class="fa-solid fa-dice-d20"></i><span>{{label}}</span><strong>{{modifierLabel}}</strong></button>{{/each}}</div><button class="mcw-player-decline" type="button" data-action="decline"><i class="fa-solid fa-ban"></i> Decline</button></div>{{/if}}
  <footer class="mcw-actions"><button type="button" data-action="close"><i class="fa-solid fa-xmark"></i> Close</button></footer>
</section>
