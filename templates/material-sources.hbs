<section class="ml-app ml-app-shell">
  <header class="ml-hero">
    <i class="fa-solid fa-map-location-dot ml-hero__icon" aria-hidden="true"></i>
    <div class="ml-hero__body"><h1>Where to find {{materialName}}</h1><p>{{sourceLabel}} sources from enabled content.</p></div>
    <div class="ml-actions"><button type="button" data-action="open-module-documentation"><i class="fa-solid fa-book-open" aria-hidden="true"></i> Documentation</button></div>
  </header>
  {{#if isGM}}
  <section class="ml-surface ml-stack" data-gap="3" aria-live="polite" aria-busy="{{loading}}">
    <div class="ml-section-heading"><div><h2>{{sourceLabel}} sources</h2><p>Sources for {{materialName}}.</p></div></div>
    {{#if loading}}<div class="ml-card ml-stack" data-gap="1" role="status"><strong><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i> Searching…</strong><p data-source-search-status>{{searchStatus}}</p></div>{{else}}
      {{#each notices}}<p class="ml-empty-message">{{this}}</p>{{/each}}
      {{#each rows}}
        {{#if uuid}}<div data-source-monster="{{@index}}"></div>{{else}}<article class="ml-card ml-stack" data-gap="1"><strong>{{name}}</strong><p>{{detail}}</p></article>{{/if}}
      {{else}}
        {{#unless failed}}{{#unless notices.length}}<p class="ml-empty-message">No enabled gathering terrain produces this material.</p>{{/unless}}{{/unless}}
      {{/each}}
    {{/if}}
  </section>
  {{else}}<p class="ml-empty-message">Material source details are GM-only.</p>{{/if}}
  <footer class="ml-page-footer"><div class="ml-actions"><button type="button" data-action="close-sources">Close</button></div></footer>
</section>
