<section class="ml-app ml-app-shell ml-craftworks app-shell ml-craftworks-browser-shell ml-craftworks-marketplace-browser ml-recipe-picker">
  <header class="ml-craftworks-header"><div><h2>{{title}}</h2><p>Browse the available catalog and select an entry.</p></div></header>
  <div class="ml-craftworks-marketplace-browser-body">
    <aside class="ml-craftworks-filter-rail">
      <div class="ml-craftworks-market-filter-title"><strong>Filters</strong><button type="button" class="ml-icon-button ml-craftworks-icon-button" data-action="clear-filters" aria-label="Clear all filters" title="Clear all filters"><i class="fa-solid fa-filter-circle-xmark"></i></button></div>
      <label class="ml-craftworks-filter-search"><span>Search</span><input type="search" name="search" value="{{search}}" autocomplete="off" placeholder="Name, source, type, rarity…"></label>
      <div class="ml-craftworks-market-filter-mode-legend"><span><i class="fa-regular fa-square"></i> Any</span><span><i class="fa-solid fa-square-check"></i> Include</span><span><i class="fa-solid fa-square-minus"></i> Exclude</span></div>

      <section class="ml-craftworks-filter-group"><h3>Type</h3><div class="ml-craftworks-tristate-list">
        {{#each types}}<button type="button" class="ml-craftworks-tristate-filter {{#if included}}is-include{{else if excluded}}is-exclude{{/if}}" data-tristate-filter data-filter-group="type" data-filter-value="{{value}}" title="Click: include → exclude → neutral"><span>{{label}}</span><small>{{count}}</small><i class="fa-solid {{#if included}}fa-plus{{else if excluded}}fa-minus{{else}}fa-circle{{/if}}"></i></button>{{/each}}
      </div></section>
      <section class="ml-craftworks-filter-group"><h3>Rarity</h3><div class="ml-craftworks-tristate-list">
        {{#each rarities}}<button type="button" class="ml-craftworks-tristate-filter {{#if included}}is-include{{else if excluded}}is-exclude{{/if}}" data-tristate-filter data-filter-group="rarity" data-filter-value="{{value}}" title="Click: include → exclude → neutral"><span>{{label}}</span><small>{{count}}</small><i class="fa-solid {{#if included}}fa-plus{{else if excluded}}fa-minus{{else}}fa-circle{{/if}}"></i></button>{{/each}}
      </div></section>
      {{#if materialMode}}<section class="ml-craftworks-filter-group"><h3>Category</h3><div class="ml-craftworks-tristate-list">
        {{#each categories}}<button type="button" class="ml-craftworks-tristate-filter {{#if included}}is-include{{else if excluded}}is-exclude{{/if}}" data-tristate-filter data-filter-group="category" data-filter-value="{{value}}" title="Click: include → exclude → neutral"><span>{{label}}</span><small>{{count}}</small><i class="fa-solid {{#if included}}fa-plus{{else if excluded}}fa-minus{{else}}fa-circle{{/if}}"></i></button>{{/each}}
      </div></section>{{/if}}
      <section class="ml-craftworks-filter-group"><h3>Source</h3><div class="ml-craftworks-tristate-list">
        {{#each sources}}<button type="button" class="ml-craftworks-tristate-filter {{#if included}}is-include{{else if excluded}}is-exclude{{/if}}" data-tristate-filter data-filter-group="source" data-filter-value="{{value}}" title="Click: include → exclude → neutral"><span>{{label}}</span><small>{{count}}</small><i class="fa-solid {{#if included}}fa-plus{{else if excluded}}fa-minus{{else}}fa-circle{{/if}}"></i></button>{{/each}}
      </div></section>
    </aside>

    <main class="ml-craftworks-marketplace-results"><div class="ml-craftworks-market-results-heading"><h2>Results</h2><span>{{resultCount}} matches</span></div><div class="ml-recipe-picker-results">
      {{#each rows}}<article class="ml-list-button ml-recipe-picker-row" data-open-document="{{uuid}}" title="Open {{name}}"><img src="{{img}}"><span><strong>{{name}}</strong><small>{{sourceLabel}} · {{type}}{{#if rarity}} · {{rarity}}{{/if}}</small></span><button type="button" class="ml-button" data-tone="accent" data-select-row="{{id}}"><i class="fa-solid fa-check"></i> Select</button></article>{{else}}<div class="ml-empty-state"><i class="fa-solid fa-magnifying-glass"></i><p>No matching entries.</p></div>{{/each}}
    </div><nav class="ml-recipe-picker-pages"><button type="button" class="ml-icon-button" data-page="{{previousPage}}" aria-label="Previous page" {{#unless hasPrevious}}disabled{{/unless}}><i class="fa-solid fa-chevron-left"></i></button><span>Page {{page}} of {{pages}}</span><button type="button" class="ml-icon-button" data-page="{{nextPage}}" aria-label="Next page" {{#unless hasNext}}disabled{{/unless}}><i class="fa-solid fa-chevron-right"></i></button></nav></main>
  </div>
</section>
