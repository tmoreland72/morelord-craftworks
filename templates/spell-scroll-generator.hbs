<section class="ml-app ml-app-shell ml-craftworks app-shell ml-craftworks-spell-scroll-generator">
  <header class="ml-hero"><i class="fa-solid fa-hammer ml-hero__icon"></i><div class="ml-hero__body"><h1>Spell Scroll Generator</h1><p>Choose scroll quantities by spell level or rarity from enabled D&amp;D5e compendium sources. Each draw is random and duplicates are allowed.</p></div>
  <div class="ml-actions"><button type="button" data-action="open-module-documentation"><i class="fa-solid fa-book-open"></i> Documentation</button></div></header>

  {{#if hasAccess}}
    {{#unless hasResult}}
    <section class="ml-surface ml-section ml-craftworks-panel ml-stack" data-gap="3">
      <div class="ml-section-heading"><div><h2>Generation Options</h2><p>Scroll rarities, schools, and generation quantities.</p></div></div>
      <fieldset class="ml-field-group ml-stack" data-gap="2">
        <legend>Schools of Magic <small>(all selected by default)</small></legend>
        <div class="ml-cluster">
          {{#each schools}}
            <label class="ml-check"><input type="checkbox" data-spell-school="{{id}}" {{#if selected}}checked{{/if}}><span>{{label}}</span></label>
          {{/each}}
        </div>
      </fieldset>
      <label>Generate By
        <select name="scrollCountMode">
          <option value="level" {{#unless byRarity}}selected{{/unless}}>Spell Level</option>
          <option value="rarity" {{#if byRarity}}selected{{/if}}>Rarity</option>
        </select>
      </label>
      {{#if byRarity}}<p class="notes">Each scroll is drawn from the spell levels in its rarity. Common: cantrip–1; Uncommon: 2–3; Rare: 4–5; Very Rare: 6–8; Legendary: 9.</p>{{/if}}
      <div class="ml-grid" data-columns="auto">
        {{#each countOptions}}
          <div class="ml-card ml-stack" data-gap="2">
            <span class="ml-stack" data-gap="1"><strong>{{label}}</strong><small>{{detail}} · {{available}} available</small></span>
            <div class="ml-stepper" data-count-stepper>
              <button type="button" data-count-adjust="-1" aria-label="Decrease {{label}}"><i class="fa-solid fa-minus"></i></button>
              <input type="number" aria-label="{{label}} count" min="0" step="1" value="{{count}}" data-scroll-count="{{key}}" {{#unless ../byRarity}}data-scroll-level="{{level}}"{{/unless}}>
              <button type="button" data-count-adjust="1" aria-label="Increase {{label}}"><i class="fa-solid fa-plus"></i></button>
            </div>
          </div>
        {{/each}}
      </div>
      <footer class="ml-page-footer ml-actions">
        <button type="button" data-action="generate-scrolls"><i class="fa-solid fa-dice"></i> Generate</button>
      </footer>
    </section>
    {{/unless}}

    {{#if hasResult}}
      <section class="ml-surface ml-section ml-craftworks-panel ml-craftworks-generator-preview ml-stack" data-gap="3">
        <div class="ml-section-heading"><div><h2><i class="fa-solid fa-scroll"></i> {{resultCount}} Generated Spell Scrolls</h2><p>Generated items and quantities.</p></div></div>
        <div class="ml-actions"><button type="button" data-action="add-result"><i class="fa-solid fa-plus"></i> Add Spell Scroll</button></div>
        <div class="ml-craftworks-generator-results">
          {{#each resultGroups}}
            <div class="ml-craftworks-generator-result-group">
              <strong>{{label}}</strong>
              <div class="ml-craftworks-generator-result-list">
                {{#each spells}}
                  <div class="ml-craftworks-generator-result-row" data-document-uuid="{{uuid}}">
                    <img src="{{img}}" alt="{{name}}">
                    <span><strong>{{name}}</strong><small>{{sourceLabel}}</small></span>
                    <label><span>Quantity</span><input type="number" min="1" step="1" value="{{quantity}}" data-result-quantity="{{resultIndex}}" aria-label="Quantity of {{name}}"></label>
                    <button type="button" data-remove-result="{{resultIndex}}" aria-label="Remove {{name}}" title="Remove {{name}}"><i class="fa-solid fa-trash"></i></button>
                    <button type="button" data-spell-uuid="{{uuid}}" title="Open {{name}}"><i class="fa-solid fa-up-right-from-square"></i></button>
                  </div>
                {{/each}}
              </div>
            </div>
          {{/each}}
        </div>
      </section>

      <section class="ml-surface ml-section ml-craftworks-panel ml-stack" data-gap="3">
        <div class="ml-section-heading"><div><h2>Recipient</h2><p>Destination inventory for the generated items.</p></div></div>
        <label>Recipient
          <select name="recipient">
            <option value="">Choose character or group…</option>
            {{#each actors}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
          </select>
        </label>
        {{#if partyInfo.valid}}<p class="notes ml-craftworks-muted">The configured default is {{partyInfo.actorName}}.</p>{{/if}}
        <footer class="ml-page-footer ml-actions">
          <button type="button" data-action="edit-scroll-options"><i class="fa-solid fa-sliders"></i> Go Back</button>
          <button type="button" data-action="reroll-scrolls"><i class="fa-solid fa-arrows-rotate"></i> Reroll</button>
          <button type="button" data-action="share-scrolls"><i class="fa-solid fa-message"></i> Display Results in Chat</button>
          <button type="button" data-action="award-scrolls"><i class="fa-solid fa-scroll"></i> Award Generated Spell Scrolls</button>
        </footer>
      </section>
    {{/if}}
  {{else}}
    <div class="ml-empty-state"><p class="ml-text ml-craftworks-warning" data-tone="premium">Spell Scroll Generator is a premium Craftworks feature.</p></div>
  {{/if}}
</section>
