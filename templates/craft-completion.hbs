<section class="ml-app ml-app-shell ml-craftworks app-shell ml-craftworks-craft-completion">
  <header class="ml-craftworks-craft-completion-hero">
    <i class="fa-solid fa-trophy"></i>
    <div>
      <h2>Crafting Success!</h2>
      <p>{{crafterName}} successfully completed {{recipeName}}.</p>
    </div>
  </header>

  <div class="ml-craftworks-craft-completion-item" data-document-uuid="{{itemUuid}}">
    <button type="button"
            class="ml-craftworks-craft-completion-image"
            data-action="open-item"
            title="Open source Item">
      <img src="{{itemImg}}" alt="{{itemName}}">
    </button>

    <div class="ml-craftworks-craft-completion-summary">
      <h3>{{itemName}}</h3>
      <div class="ml-craftworks-recipe-meta">
        {{#if sourceLabel}}<span>{{sourceLabel}}</span>{{/if}}
        {{#if rarity}}<span>{{rarity}}</span>{{/if}}
        {{#if price}}<span>{{price}}</span>{{/if}}
        <span>Quantity: {{quantity}}</span>
      </div>
    </div>
  </div>

  {{#if description}}
    <div class="ml-craftworks-panel ml-craftworks-craft-completion-description">
      {{{description}}}
    </div>
  {{/if}}

  <div class="ml-craftworks-craft-completion-actions">
    <button type="button"
            class="ml-craftworks-primary-action"
            data-action="place-self">
      <i class="fa-solid fa-user"></i>
      Place in My Inventory
    </button>

    {{#if partyActor}}
      <button type="button"
              data-action="place-party">
        <i class="fa-solid fa-users"></i>
        Place in {{partyActor.name}} Inventory
      </button>
    {{/if}}
  </div>

  <p class="ml-craftworks-muted">
    The crafted Item is not placed anywhere until you choose a destination.
  </p>
</section>
