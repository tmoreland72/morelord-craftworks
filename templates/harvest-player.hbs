<div class="mlh-shell mcw-harvest-modern">
  <header class="mlh-header">
    <div class="mlh-title">
      <div>
        <h1><i class="fa-solid fa-scalpel"></i> Harvesting</h1>
        <div class="mlh-scene">{{session.sceneName}}</div>
      </div>
    </div>

    {{#if actor}}
      <div class="mlh-user">
        {{#if actor.img}}<img src="{{actor.img}}" alt="{{actor.name}}">{{/if}}
        <div><strong>{{actor.name}}</strong><span>{{game.user.name}}</span></div>
      </div>
      <div class="mlh-instructions">
        Choose one Harvest skill and roll all unresolved creature checks at once.
        Successful creatures will immediately show their claimable components.
      </div>
    {{else}}
      <div class="mlh-instructions mcw-warning">No character is available. Select a token you own or configure a user character.</div>
    {{/if}}

    <div class="mlh-summary">
      <span><i class="fa-solid fa-skull"></i> {{summary.creatures}} Creatures</span>
      <span><i class="fa-solid fa-check"></i> {{summary.completed}} Resolved</span>
      {{#if summary.drakkenheim}}<span><i class="fa-solid fa-radiation"></i> {{summary.drakkenheim}} Drakkenheim</span>{{/if}}
    </div>

    {{#if actor}}
      {{#if skillChecksBypassed}}
        <section class="mlh-batch-check mlh-skill-check-bypassed">
          <i class="fa-solid fa-forward"></i>
          <div>
            <strong>Skill Checks Bypassed</strong>
            <small>
              The GM granted {{actor.name}} automatic success. No Harvest
              rolls are required; choose from the highlighted components below.
            </small>
          </div>
        </section>
      {{else}}
        <section class="mlh-batch-check">
        <div class="mlh-batch-check-copy">
          <strong>Harvest Skill Check</strong>
          {{#if availableSkillCheckCount}}
            <small>
              {{availableSkillCheckCount}} unresolved creature check(s) will be rolled.
            </small>
          {{else}}
            <small>All creature checks are already resolved or skipped.</small>
          {{/if}}
        </div>

        <div class="mlh-batch-check-controls">
          <select
            data-action="select-harvest-skill"
            aria-label="Harvest skill"
            {{#unless availableSkillCheckCount}}disabled{{/unless}}
          >
            <option value="">Choose skill...</option>
            {{#each skills}}
              <option
                value="{{id}}"
                {{#if selected}}selected{{/if}}
              >
                {{label}}
              </option>
            {{/each}}
          </select>

          <button
            type="button"
            data-action="roll-harvest-checks"
            data-available-count="{{availableSkillCheckCount}}"
            {{#unless canRollHarvestChecks}}disabled{{/unless}}
          >
            <i class="fa-solid fa-dice-d20"></i>
            Roll Harvest Checks
          </button>
        </div>
        </section>
      {{/if}}
    {{/if}}
  </header>

  <main class="mlh-creatures">
    {{#each creatures}}
      <section class="mlh-creature {{#if isCollapsed}}mlh-creature-collapsed{{/if}}" data-creature-token="{{tokenUuid}}">
        <header class="mlh-creature-header">
          {{#if img}}<img class="mlh-creature-image" src="{{img}}" alt="{{name}}">{{/if}}
          <div class="mlh-creature-info">
            <h2>{{name}}</h2>
            <div class="mlh-creature-meta">
              <span>{{creatureType}} · CR {{cr}}</span>
              <span>Harvest DC {{dc}}</span>
              {{#if rarity}}<span class="mlh-rarity">{{rarity}}</span>{{/if}}
              {{#if (eq harvestMode "drakkenheim")}}<span class="mlh-has-claim"><i class="fa-solid fa-radiation"></i> Drakkenheim</span>{{/if}}
            </div>
          </div>
          <button type="button" class="mlh-creature-toggle" data-action="toggle-creature" data-creature="{{tokenUuid}}" title="{{#if isCollapsed}}Expand{{else}}Collapse{{/if}}">
            <i class="fa-solid {{#if isCollapsed}}fa-chevron-down{{else}}fa-chevron-up{{/if}}"></i>
          </button>
        </header>

        {{#unless isCollapsed}}
          {{#if alreadyHarvested}}
            <div class="mlh-harvest-message mlh-locked">
              <i class="fa-solid fa-lock"></i>
              This character has already attempted to harvest this creature.
            </div>
          {{else if state}}
            {{#if (eq state.status "pending")}}
              <div class="mlh-harvest-message">
                <i class="fa-solid fa-spinner fa-spin"></i>
                Resolving harvest check...
              </div>
            {{/if}}

            {{#if (eq state.status "failed")}}
              <div class="mlh-harvest-message mcw-failure">
                <i class="fa-solid fa-xmark"></i>
                Failed with {{state.total}}. No component recovered.
              </div>
            {{/if}}

            {{#if (eq state.status "no-results")}}
              <div class="mlh-harvest-message mcw-warning">
                <i class="fa-solid fa-triangle-exclamation"></i>
                The check succeeded, but no compatible component is available.
              </div>
            {{/if}}

            {{#if (eq state.status "awaiting-claim")}}
              <div class="mlh-harvest-message mlh-mine">
                <i class="fa-solid fa-check"></i>
                {{#if state.automaticSuccess}}
                  Skill check skipped by the GM. Choose one highlighted component.
                {{else if state.claimsMade}}
                  Natural 20 harvest: choose {{state.claimsRemaining}} more highlighted component.
                {{else if (eq state.claimsAllowed 2)}}
                  Natural 20! Harvest succeeded with {{state.total}}. Choose two highlighted components.
                {{else}}
                  Harvest succeeded with {{state.total}}. Choose one highlighted component.
                {{/if}}
              </div>
            {{/if}}

            {{#if (eq state.status "claimed")}}
              <div class="mlh-harvest-message mlh-mine">
                <i class="fa-solid fa-check-double"></i>
                {{#if (eq state.claimsMade 2)}}
                  Natural 20 harvest complete. Claimed two components.
                {{else}}
                  Claimed {{state.claimedName}}.
                {{/if}}
              </div>
            {{/if}}
          {{/if}}

          <div class="mlh-components">
            {{#each displayComponents}}
              <article class="mlh-component {{#if claimable}}mlh-component-available{{else}}mlh-component-unavailable{{/if}} {{#if neededForCrafting}}mlh-component-needed{{/if}}" data-document-uuid="{{itemUuid}}">
                <div class="mlh-component-image">
                  {{#if img}}
                    <img src="{{img}}" alt="{{name}}">
                  {{else}}
                    <i class="fa-solid fa-flask"></i>
                  {{/if}}
                </div>

                <div class="mlh-component-body">
                  <div class="mlh-component-name">{{componentName}}</div>
                  <div class="mlh-component-category">
                    {{category}}{{#if rarity}} · {{rarity}}{{/if}}
                  </div>
                  {{#if name}}
                    <div class="mlh-ingredient-name">
                      <i class="fa-solid fa-arrow-right"></i>{{name}}
                    </div>
                  {{/if}}

                  {{#if neededForCrafting}}
                    <div class="mlh-needed-recipes">
                      <i class="fa-solid fa-hammer"></i>
                      {{#each visibleRecipes}}
                        <span class="mlh-recipe-tag">{{name}}</span>
                      {{/each}}
                      {{#if hasMoreRecipes}}
                        <button type="button"
                                class="mlh-recipe-help"
                                data-action="show-matching-recipes"
                                data-material="{{materialId}}"
                                title="Show all {{recipeCount}} matching recipes">
                          <i class="fa-solid fa-circle-question"></i>
                        </button>
                      {{/if}}
                    </div>
                  {{/if}}
                </div>

                <div class="mlh-component-action">
                  {{#if claimed}}
                    <div class="mlh-claim-status {{#if claimedByCurrentUser}}mlh-mine{{else}}mlh-taken{{/if}}">
                      <i class="fa-solid {{#if claimedByCurrentUser}}fa-check{{else}}fa-lock{{/if}}"></i>
                      <span>
                        {{#if claimedByCurrentUser}}
                          Claimed by you
                        {{else}}
                          Claimed by <strong>{{claimantName}}</strong>
                        {{/if}}
                        {{#if claimRoll}}
                          · Roll {{claimRoll}}
                        {{/if}}
                      </span>
                    </div>
                  {{else}}
                    <button
                      type="button"
                      class="mlh-claim"
                      data-action="claim"
                      data-creature="{{../tokenUuid}}"
                      data-material="{{materialId}}"
                      data-component="{{id}}"
                      {{#unless claimable}}disabled{{/unless}}
                    >
                      <i class="fa-solid fa-hand"></i> Claim
                    </button>
                  {{/if}}
                </div>
              </article>
            {{/each}}

            {{#unless displayComponents.length}}
              <div class="mlh-harvest-message mcw-warning">
                No compatible Craftworks components are available for this creature.
              </div>
            {{/unless}}
          </div>
        {{/unless}}
      </section>
    {{/each}}

    <section class="mlh-claimed-section">
      <div class="mlh-claimed-heading">
        <div>
          <i class="fa-solid fa-box-open"></i>
          <span>Claimed Components</span>
        </div>
        <span class="mlh-claimed-count">{{summary.claimed}}</span>
      </div>

      {{#if claimedItems.length}}
        <div class="mlh-claimed-list">
          {{#each claimedItems}}
            <article class="mlh-claimed-item {{#if neededForCrafting}}mlh-claimed-needed{{/if}}" data-document-uuid="{{linkUuid}}">
              <button
                type="button"
                class="mlh-claimed-image-link"
                data-action="open-claimed-item"
                data-uuid="{{linkUuid}}"
                {{#unless linkUuid}}disabled{{/unless}}
                title="{{#if linkUuid}}Open {{displayName}}{{else}}{{displayName}}{{/if}}"
              >
                {{#if displayImg}}
                  <img src="{{displayImg}}" alt="{{displayName}}">
                {{else}}
                  <i class="fa-solid fa-flask"></i>
                {{/if}}
              </button>

              <div class="mlh-claimed-body">
                <div class="mlh-claimed-name">
                  {{displayName}}
                  {{#if neededForCrafting}}
                    <span class="mlh-needed-inline">
                      <i class="fa-solid fa-hammer"></i>
                      {{#each visibleRecipes}}
                        <span class="mlh-recipe-tag">{{name}}</span>
                      {{/each}}
                      {{#if hasMoreRecipes}}
                        <button type="button"
                                class="mlh-recipe-help"
                                data-action="show-matching-recipes"
                                data-material="{{materialId}}"
                                title="Show all {{recipeCount}} matching recipes">
                          <i class="fa-solid fa-circle-question"></i>
                        </button>
                      {{/if}}
                    </span>
                  {{/if}}
                </div>
                <div class="mlh-claimed-meta">
                  <span class="mlh-claimed-rarity">{{displayRarity}}</span>
                  <span>{{creatureName}}</span>
                  <span>Claimed by {{displayClaimant}}</span>
                </div>
              </div>

              <div class="mlh-claimed-roll">
                <span>Harvest Roll</span>
                <strong>{{displayRoll}}</strong>
              </div>
            </article>
          {{/each}}
        </div>
      {{else}}
        <div class="mlh-claimed-empty">
          No components have been claimed yet.
        </div>
      {{/if}}
    </section>
  </main>

  <footer class="mlh-footer">
    <div class="mlh-footer-status"><span>{{summary.completed}} of {{summary.creatures}} creature attempts resolved</span></div>
    <button type="button" data-action="close"><i class="fa-solid fa-xmark"></i> Close</button>
  </footer>
</div>
