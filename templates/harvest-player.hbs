<div class="ml-app ml-app-shell ml-craftworks-harvest-shell" data-ml-responsive>
  <header class="ml-hero"><i class="fa-solid fa-scalpel ml-hero__icon"></i><div class="ml-hero__body"><h1>Harvesting</h1><p>Choose components from {{session.sceneName}}, one creature at a time.</p></div><div class="ml-actions"><button type="button" data-action="open-module-documentation"><i class="fa-solid fa-book-open"></i> Documentation</button></div></header>
  {{#if actor}}<div class="ml-actor-identity"><img class="ml-avatar" src="{{actor.img}}" alt=""><span>{{actor.name}}</span></div>{{else}}<p class="ml-text" data-tone="warning">No harvesting character is available.</p>{{/if}}
  <main class="ml-grid ml-craftworks-harvest-walkthrough" data-columns="2">
    <aside class="ml-surface ml-section ml-stack" data-gap="3">
      <div class="ml-section-heading"><div><h2>Claimed Components</h2><p>{{summary.claimed}} claimed by your character. The GM finalizes awards.</p></div></div>
      {{#each claimedItems}}
        <article class="ml-card ml-item-row" data-document-uuid="{{linkUuid}}">
          <img src="{{displayImg}}" alt="">
          <div class="ml-stack" data-gap="1"><strong>{{displayName}} ×{{quantity}}</strong><small>{{creatureName}} · {{displayRarity}}</small></div>
          {{#if linkUuid}}<button type="button" class="ml-icon-button" data-action="open-claimed-item" data-uuid="{{linkUuid}}" aria-label="Open {{displayName}}"><i class="fa-solid fa-arrow-up-right-from-square"></i></button>{{/if}}
        </article>
      {{else}}<p class="ml-empty-message">No components claimed yet.</p>{{/each}}
    </aside>
    <section class="ml-surface ml-section ml-stack" data-gap="3">
      {{#if completed}}
        <div class="ml-empty-state"><i class="fa-solid fa-circle-check"></i><h2>Harvesting Completed</h2><p>The GM has been notified. Your claimed components remain reserved.</p></div>
      {{else}}
        {{#with currentCreature}}
          <div class="ml-section-heading"><div><h2>Creature {{@root.creatureNumber}} of {{@root.summary.creatures}}</h2><p>Resolve this creature, claim components, then continue.</p></div></div>
          <header class="ml-card ml-item-row" data-creature-token="{{tokenUuid}}">
            {{#if img}}<img src="{{img}}" alt="">{{/if}}
            <div class="ml-stack" data-gap="1"><h3>{{name}}</h3><small>{{creatureType}} · CR {{cr}}{{#if rarity}} · {{rarity}}{{/if}}{{#unless (eq harvestMode "drakkenheim")}} · Harvest DC {{dc}}{{/unless}}</small></div>
            {{#if (eq harvestMode "drakkenheim")}}<span class="ml-badge" data-tone="info">Drakkenheim</span>{{/if}}
          </header>
          {{#if requiresSkillCheck}}
            <section class="ml-card ml-stack" data-gap="2">
              <strong>Harvest Skill Check</strong><p class="notes">Roll once for this creature. A successful check reveals claimable components.</p>
              <div class="ml-grid" data-columns="2">
                <select data-action="select-harvest-skill" aria-label="Harvest skill"><option value="">Choose skill...</option>{{#each @root.skills}}<option value="{{id}}" data-skill-label="{{label}} {{modifierLabel}}" {{#if selected}}selected{{/if}}>{{label}} ({{modifierLabel}})</option>{{/each}}</select>
                <button type="button" data-action="roll-harvest-checks" data-available-count="1" {{#unless @root.canRollHarvestChecks}}disabled{{/unless}}><i class="fa-solid fa-dice-d20"></i> <span data-roll-skill-label>Roll Harvest Check</span></button>
              </div>
            </section>
          {{/if}}
          {{#if (eq state.status "previously-harvested")}}<p class="ml-text" data-tone="warning">This character has already attempted to harvest this creature.</p>{{/if}}
          {{#if (eq state.status "failed")}}<p class="ml-text" data-tone="danger">Failed with {{state.total}}. No component recovered.</p>{{/if}}
          {{#if (eq state.status "no-results")}}<p class="ml-text" data-tone="warning">No compatible component is available.</p>{{/if}}
          {{#if (eq state.status "awaiting-claim")}}
            <p class="ml-text" data-tone="success">{{#if (eq state.claimsAllowed 2)}}Natural 20! Choose {{state.claimsRemaining}} more component(s).{{else}}{{#if state.total includeZero=true}}Harvest succeeded with {{state.total}}.{{else}}Skill check skipped.{{/if}} Choose one component.{{/if}}</p>
          {{/if}}
          {{#if (eq state.status "claimed")}}<p class="ml-text" data-tone="success">Claimed {{state.claimedName}}.{{#if (eq state.claimsMade 2)}} Two components claimed.{{/if}}</p>{{/if}}
          <div class="ml-stack" data-gap="2">
            {{#each displayComponents}}
              <article class="ml-card ml-item-row" data-document-uuid="{{itemUuid}}">
                {{#if img}}<img src="{{img}}" alt="">{{/if}}
                <div class="ml-stack" data-gap="1">
                  <strong>{{componentName}}{{#if quantity}} ×{{quantity}}{{/if}}</strong><small>{{category}}{{#if rarity}} · {{rarity}}{{/if}}{{#if harvestDc}} · DC {{harvestDc}}{{/if}}{{#if sourceRoll}} · d100 {{sourceRoll}}{{/if}}</small>
                  {{#if neededForCrafting}}<div class="ml-cluster">{{#each visibleRecipes}}<span class="ml-badge" data-tone="premium" title="{{name}} — personal and party inventory / required">{{name}} {{available}}/{{required}}</span>{{/each}}{{#if hasMoreRecipes}}<button type="button" data-action="show-matching-recipes" data-material="{{materialId}}">More recipes...</button>{{/if}}</div>{{/if}}
                  {{#if hasVisibleClaims}}<small>{{#if claimedByCurrentUser}}Claimed by you{{else}}Claimed by {{claimantNames}}{{/if}}</small>{{/if}}
                </div>
                {{#unless claimed}}<button type="button" data-action="claim" data-creature="{{../tokenUuid}}" data-material="{{materialId}}" data-component="{{id}}" {{#unless claimable}}disabled{{/unless}}><i class="fa-solid fa-hand"></i> Claim</button>{{/unless}}
              </article>
            {{else}}<p class="ml-empty-message">No compatible Craftworks components are available.</p>{{/each}}
          </div>
        {{/with}}
      {{/if}}
    </section>
  </main>
  <footer class="ml-page-footer ml-actions">
    <span>{{#if completed}}Harvesting Completed{{else}}Creature {{creatureNumber}} of {{summary.creatures}}{{/if}}</span>
    <div class="ml-actions">
      {{#if completed}}<button type="button" data-action="close">Close</button>
      {{else if isLastCreature}}<button type="button" data-action="done-creature"><i class="fa-solid fa-check"></i> Done</button>
      {{else}}<button type="button" data-action="skip-creature">Skip Remaining</button><button type="button" data-action="next-creature" {{#unless canAdvance}}disabled{{/unless}}>Next <i class="fa-solid fa-arrow-right"></i></button>{{/if}}
    </div>
  </footer>
</div>
