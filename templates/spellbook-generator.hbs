<section class="ml-app ml-app-shell ml-craftworks app-shell ml-craftworks-spellbook-generator">
  <header class="ml-craftworks-header">
    <div>
      <h2>Spellbook Generator</h2>
      <p>
        Choose how many spells of each level the recovered spellbook contains.
        Generate a random draft, reroll until satisfied, then create the book.
      </p>
    </div>
  </header>

  {{#if hasAccess}}
    {{#unless hasResult}}
    <section class="ml-craftworks-panel">
      <label class="ml-craftworks-spellbook-name">
        <span>Spellbook Name</span>
        <input
          type="text"
          name="spellbook-name"
          value="{{bookName}}"
        >
      </label>

      <fieldset class="ml-craftworks-generator-constraints">
        <legend>Schools of Magic <small>(all selected by default)</small></legend>
        <div class="ml-craftworks-generator-option-grid">
          {{#each schools}}
            <label><input type="checkbox" data-spell-school="{{id}}" {{#if selected}}checked{{/if}}> {{label}}</label>
          {{/each}}
        </div>
      </fieldset>

      <div class="ml-craftworks-spellbook-level-grid">
        {{#each levels}}
          <label class="ml-craftworks-spellbook-level-row">
            <span>
              <strong>{{label}}</strong>
              <small>{{available}} available</small>
            </span>
            <input
              type="number"
              min="0"
              max="{{available}}"
              step="1"
              value="{{count}}"
              data-spellbook-level="{{level}}"
            >
          </label>
        {{/each}}
      </div>

      <div class="ml-actions ml-craftworks-actions">
        <button
          type="button"
          data-action="generate-spellbook"
        >
          <i class="fa-solid fa-dice"></i>
          Generate
        </button>

      </div>
    </section>
    {{/unless}}

    {{#if hasResult}}
      <section class="ml-craftworks-panel ml-craftworks-spellbook-preview">
        <div class="ml-craftworks-spellbook-preview-heading">
          <i class="fa-solid fa-book"></i>
          <h3>{{bookName}}</h3>
        </div>

        <div class="ml-craftworks-spellbook-results-scroll">
          {{#each resultGroups}}
            <div class="ml-craftworks-spellbook-result-level">
              <strong>{{label}}</strong>
              <div class="ml-craftworks-spellbook-result-list">
                {{#each spells}}
                  <div class="ml-craftworks-spellbook-spell" data-document-uuid="{{uuid}}">
                    <img
                      class="ml-craftworks-spellbook-spell-image"
                      src="{{img}}"
                      alt="{{name}}"
                    >

                    <div class="ml-craftworks-spellbook-spell-copy">
                      <strong>{{name}}</strong>
                      <small>{{sourceLabel}}</small>
                    </div>

                    <button
                      type="button"
                      class="ml-craftworks-spellbook-spell-open"
                      data-spell-uuid="{{uuid}}"
                      title="Open {{name}}"
                      aria-label="Open {{name}}"
                    >
                      <i class="fa-solid fa-up-right-from-square"></i>
                    </button>
                  </div>
                {{/each}}
              </div>
            </div>
          {{/each}}
        </div>
      </section>

      <section class="ml-craftworks-panel">
        <h3>Recipient</h3>

        <label>
          Recipient
          <select name="recipient">
            <option value="">Choose character or group…</option>
            {{#each actors}}
              <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>
            {{/each}}
          </select>
        </label>
        {{#if partyInfo.valid}}<p class="ml-craftworks-muted">The configured default is {{partyInfo.actorName}}.</p>{{/if}}

        <div class="ml-actions ml-craftworks-actions">
          <button type="button" data-action="reroll-spellbook">
            <i class="fa-solid fa-arrows-rotate"></i>
            Reroll
          </button>
          <button
            type="button"
            data-action="award-spellbook"
          >
            <i class="fa-solid fa-book"></i>
            Create & Award Spellbook
          </button>
        </div>
      </section>
    {{/if}}
  {{else}}
    <div class="ml-craftworks-panel">
      <p class="ml-text ml-craftworks-warning" data-tone="warning">
        Spellbook Generator requires premium Craftworks access.
      </p>
    </div>
  {{/if}}
</section>
