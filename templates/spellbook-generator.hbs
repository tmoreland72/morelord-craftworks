<section class="ml-app ml-app-shell ml-craftworks app-shell ml-craftworks-spellbook-generator">
  <header class="ml-hero"><i class="fa-solid fa-hammer ml-hero__icon"></i><div class="ml-hero__body"><h1>Spellbook Generator</h1><p>
        Choose how many spells of each level the recovered spellbook contains.
        Generate a random draft, reroll until satisfied, then create the book.
      </p></div>
  <div class="ml-actions"><button type="button" data-action="open-module-documentation"><i class="fa-solid fa-book-open"></i> Documentation</button></div></header>

  {{#if hasAccess}}
    {{#unless hasResult}}
    <section class="ml-surface ml-section ml-craftworks-panel ml-stack" data-gap="3">
      <div class="ml-section-heading"><div><h2>Generation Options</h2><p>Choose the available options and quantities to generate.</p></div></div>
      <label class="ml-craftworks-spellbook-name">
        <span>Spellbook Name</span>
        <input
          type="text"
          name="spellbook-name"
          value="{{bookName}}"
        >
      </label>

      <fieldset class="ml-craftworks-generator-constraints">
        <legend>Schools of Magic <small>(all selected by default)</small></legend>
        <div class="ml-craftworks-generator-option-grid">
          {{#each schools}}
            <label><input type="checkbox" data-spell-school="{{id}}" {{#if selected}}checked{{/if}}> {{label}}</label>
          {{/each}}
        </div>
      </fieldset>

      <div class="ml-craftworks-spellbook-level-grid">
        {{#each levels}}
          <label class="ml-craftworks-spellbook-level-row">
            <span>
              <strong>{{label}}</strong>
              <small>{{available}} available</small>
            </span>
            <span class="ml-craftworks-generator-stepper" data-count-stepper>
              <input
                type="number"
                min="0"
                max="{{available}}"
                step="1"
                value="{{count}}"
                data-spellbook-level="{{level}}"
              >
              <span class="ml-craftworks-generator-stepper-controls">
                <button type="button" data-count-adjust="1" aria-label="Add one {{label}} spell"><i class="fa-solid fa-chevron-up"></i></button>
                <button type="button" data-count-adjust="-1" aria-label="Remove one {{label}} spell"><i class="fa-solid fa-chevron-down"></i></button>
              </span>
            </span>
          </label>
        {{/each}}
      </div>

      <footer class="ml-page-footer ml-actions">
        <button
          type="button"
          data-action="generate-spellbook"
        >
          <i class="fa-solid fa-dice"></i>
          Generate
        </button>

      </footer>
    </section>
    {{/unless}}

    {{#if hasResult}}
      <section class="ml-surface ml-section ml-craftworks-panel ml-craftworks-spellbook-preview ml-stack" data-gap="3">
        <div class="ml-section-heading"><div><h2>{{bookName}}</h2><p>Review and customize the spells in this generated book.</p></div></div>

        <div class="ml-craftworks-spellbook-results-scroll">
          {{#each resultGroups}}
            <div class="ml-craftworks-spellbook-result-level">
              <strong>{{label}}</strong>
              <div class="ml-craftworks-spellbook-result-list">
                {{#each spells}}
                  <div class="ml-craftworks-spellbook-spell" data-document-uuid="{{uuid}}">
                    <img
                      class="ml-craftworks-spellbook-spell-image"
                      src="{{img}}"
                      alt="{{name}}"
                    >

                    <div class="ml-craftworks-spellbook-spell-copy">
                      <strong>{{name}}</strong>
                      <small>{{sourceLabel}}</small>
                    </div>

                    <button
                      type="button"
                      class="ml-craftworks-spellbook-spell-open"
                      data-spell-uuid="{{uuid}}"
                      title="Open {{name}}"
                      aria-label="Open {{name}}"
                    >
                      <i class="fa-solid fa-up-right-from-square"></i>
                    </button>
                  </div>
                {{/each}}
              </div>
            </div>
          {{/each}}
        </div>
      </section>

      <section class="ml-surface ml-section ml-craftworks-panel ml-stack" data-gap="3">
        <div class="ml-section-heading"><div><h2>Recipient</h2><p>Choose the character or party inventory that receives these items.</p></div></div>

        <label>
          Recipient
          <select name="recipient">
            <option value="">Choose character or group…</option>
            {{#each actors}}
              <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>
            {{/each}}
          </select>
        </label>
        {{#if partyInfo.valid}}<p class="ml-craftworks-muted">The configured default is {{partyInfo.actorName}}.</p>{{/if}}

        <footer class="ml-page-footer ml-actions">
          <button type="button" data-action="reroll-spellbook">
            <i class="fa-solid fa-arrows-rotate"></i>
            Reroll
          </button>
          <button
            type="button"
            data-action="award-spellbook"
          >
            <i class="fa-solid fa-book"></i>
            Create & Award Spellbook
          </button>
        </footer>
      </section>
    {{/if}}
  {{else}}
    <div class="ml-empty-state">
      <p class="ml-text ml-craftworks-warning" data-tone="warning">
        Spellbook Generator requires premium Craftworks access.
      </p>
    </div>
  {{/if}}
</section>
