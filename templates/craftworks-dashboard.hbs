<section class="ml-app ml-app-shell ml-craftworks-dashboard ml-craftworks app-shell ml-craftworks-dashboard">
  <header class="ml-hero ml-craftworks-hero ml-craftworks-dashboard-hero">
    <div class="ml-hero__body">
      <h1>Morelord Craftworks</h1>
      <p>Gather, harvest, loot, and understand the materials that drive your crafting economy.</p>
    </div>
    <button type="button" data-action="refresh" class="ml-icon-button ml-craftworks-icon-button" title="Refresh" aria-label="Refresh">
      <i class="fa-solid fa-arrows-rotate"></i>
    </button>
  </header>

  {{#if isGM}}
    <section class="ml-section ml-craftworks-dashboard-section">
      <div class="ml-section-heading ml-craftworks-dashboard-section-header">
        <div>
          <h2>Acquire</h2>
          {{#if scene}}
            <p>Current scene: <strong>{{scene.name}}</strong></p>
          {{else}}
            <p>No active scene.</p>
          {{/if}}
        </div>
      </div>

      <div class="ml-craftworks-dashboard-grid ml-craftworks-dashboard-acquire">
        <button type="button" class="ml-card ml-craftworks-dashboard-card" data-action="harvest" {{#unless scene}}disabled{{/unless}}>
          <i class="fa-solid fa-skull"></i>
          <span class="ml-craftworks-dashboard-card-copy">
            <strong>Harvest</strong>
            <small>{{deadCreatureCount}} dead creature(s) detected</small>
          </span>
          <i class="fa-solid fa-chevron-right"></i>
        </button>

        <button type="button" class="ml-card ml-craftworks-dashboard-card" data-action="gather" {{#unless scene}}disabled{{/unless}}>
          <i class="fa-solid fa-seedling"></i>
          <span class="ml-craftworks-dashboard-card-copy">
            <strong>Gather</strong>
            <small>{{gatherRecordCount}} character(s) already gathered here</small>
          </span>
          <i class="fa-solid fa-chevron-right"></i>
        </button>

        {{#if deleriumSearchAvailable}}
          <button type="button" class="ml-card ml-craftworks-dashboard-card" data-action="delerium-search" {{#unless scene}}disabled{{/unless}}>
            <i class="fa-solid fa-gem"></i>
            <span class="ml-craftworks-dashboard-card-copy"><strong>Delerium Search</strong><small>Search a ¼-mile hex in the ruins of Drakkenheim</small></span>
            <i class="fa-solid fa-chevron-right"></i>
          </button>
        {{/if}}

        <button type="button" class="ml-card ml-craftworks-dashboard-card" data-action="loot" {{#unless scene}}disabled{{/unless}}>
          <i class="fa-solid fa-sack-dollar"></i>
          <span class="ml-craftworks-dashboard-card-copy">
            <strong>Loot</strong>
            <small>Materials, coin, and rare special treasure</small>
          </span>
          <i class="fa-solid fa-chevron-right"></i>
        </button>

        <button type="button" class="ml-card ml-craftworks-dashboard-card" data-action="hoard">
          <i class="fa-solid fa-vault"></i>
          <span class="ml-craftworks-dashboard-card-copy">
            <strong>Hoard</strong>
            <small>Accumulated treasure for a lair, vault, or cache</small>
          </span>
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>
    </section>
  {{/if}}

  <section class="ml-section ml-craftworks-dashboard-section">
    <div class="ml-section-heading ml-craftworks-dashboard-section-header">
      <div>
        <h2>Craft</h2>
        <p>Review materials and find recipes for the items you want to create.</p>
      </div>
    </div>

    <div class="ml-craftworks-dashboard-grid">
      <button type="button" class="ml-card ml-craftworks-dashboard-card" data-action="materials">
        <i class="fa-solid fa-gem"></i>
        <span class="ml-craftworks-dashboard-card-copy">
          <strong>Materials</strong>
          <small>{{materialsCount}} indexed materials</small>
        </span>
        <i class="fa-solid fa-chevron-right"></i>
      </button>

      <button type="button" class="ml-card ml-craftworks-dashboard-card" data-action="recipes">
        <i class="fa-solid fa-scroll"></i>
        <span class="ml-craftworks-dashboard-card-copy">
          <strong>Recipes</strong>
          <small>{{recipesCount}} reference recipes</small>
        </span>
        <i class="fa-solid fa-chevron-right"></i>
      </button>

      <button type="button" class="ml-card ml-craftworks-dashboard-card" data-action="craft">
        <i class="fa-solid fa-hammer"></i>
        <span class="ml-craftworks-dashboard-card-copy">
          <strong>Craft</strong>
          <small>Work on recipes you have marked for crafting</small>
        </span>
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
  </section>

  {{#if isGM}}
    <section class="ml-section ml-craftworks-dashboard-section">
      <div class="ml-section-heading ml-craftworks-dashboard-section-header">
        <div>
          <h2>Tools</h2>
          <p>GM utilities for crafting and generated treasure.</p>
        </div>
      </div>

      <div class="ml-craftworks-dashboard-grid">
        <button type="button"
                class="ml-card ml-craftworks-dashboard-card"
                data-action="spell-scroll-generator">
          <i class="fa-solid fa-scroll"></i>
          <span class="ml-craftworks-dashboard-card-copy">
            <strong>Spell Scroll Generator</strong>
            <small>
              {{#if spellScrollGeneratorPremium}}
                Generate a spell from enabled spell compendiums
              {{else}}
                Premium · Generate a spell from enabled spell compendiums
              {{/if}}
            </small>
          </span>
          <i class="fa-solid fa-chevron-right"></i>
        </button>

        <button type="button"
                class="ml-card ml-craftworks-dashboard-card"
                data-action="spellbook-generator">
          <i class="fa-solid fa-book"></i>
          <span class="ml-craftworks-dashboard-card-copy">
            <strong>Spellbook Generator</strong>
            <small>
              {{#if spellbookGeneratorPremium}}
                Randomize a custom spellbook from enabled spell sources
              {{else}}
                Premium · Randomize a custom spellbook from enabled spell sources
              {{/if}}
            </small>
          </span>
          <i class="fa-solid fa-chevron-right"></i>
        </button>

        <button type="button"
                class="ml-card ml-craftworks-dashboard-card"
                data-action="potion-generator">
          <i class="fa-solid fa-flask"></i>
          <span class="ml-craftworks-dashboard-card-copy">
            <strong>Potion Generator</strong>
            <small>
              {{#if potionGeneratorPremium}}
                Generate random potions by rarity from enabled Item compendiums
              {{else}}
                Premium · Generate random potions by rarity
              {{/if}}
            </small>
          </span>
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>
    </section>


  {{else}}
    <section class="ml-section ml-craftworks-dashboard-section">
      <div class="ml-craftworks-panel">
        <i class="fa-solid fa-circle-info"></i>
        <span>Acquisition sessions are started by the GM. Materials and Recipes are available as reference tools.</span>
      </div>
    </section>
  {{/if}}

</section>
